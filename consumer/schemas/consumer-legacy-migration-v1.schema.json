{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/consumer-legacy-migration-v1.schema.json",
  "title": "Consumer legacy migration inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repositories": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "pattern": "^(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[*?\\[\\]])[^/]+(?:/[^/]+)*$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "kind": { "enum": ["pester", "general"] },
        "path": { "$ref": "#/$defs/path" }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "requirement"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "path": { "$ref": "#/$defs/path" },
        "requirement": { "type": "string", "minLength": 1 }
      }
    },
    "literalReferenceExemption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "blobOid", "line", "column", "occurrenceOrdinal", "targetPath", "reason"],
      "properties": {
        "file": { "$ref": "#/$defs/path" },
        "blobOid": { "$ref": "#/$defs/sha1" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "occurrenceOrdinal": { "type": "integer", "minimum": 1 },
        "targetPath": { "$ref": "#/$defs/path" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "disposition", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "disposition": { "enum": ["delete", "split", "retain", "update-tests"] },
        "target": { "$ref": "#/$defs/path" },
        "expectedOutcome": { "enum": ["delete", "rewrite"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "split" } } },
          "then": { "required": ["target"] },
          "else": { "not": { "required": ["target"] } }
        },
        {
          "if": { "properties": { "disposition": { "const": "update-tests" } } },
          "then": { "required": ["expectedOutcome"] },
          "else": { "not": { "required": ["expectedOutcome"] } }
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "status", "inventoryCommit", "inventoryTree", "requiredRepositoryChecks", "files"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$" },
        "status": { "enum": ["ready", "pending-prerequisites"] },
        "inventoryCommit": { "$ref": "#/$defs/sha1" },
        "inventoryTree": { "$ref": "#/$defs/sha1" },
        "requiredRepositoryChecks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/check" } },
        "additionalScope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[*?\\[\\]])[^/]+(?:/[^/]+)*/$"
          }
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/prerequisite" }
        },
        "literalReferenceExemptions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/literalReferenceExemption" }
        },
        "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/file" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pending-prerequisites" } } },
          "then": { "required": ["prerequisites"] },
          "else": { "not": { "required": ["prerequisites"] } }
        }
      ]
    }
  }
}
