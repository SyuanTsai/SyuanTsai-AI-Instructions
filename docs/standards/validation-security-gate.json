{
  "schemaVersion": 1,
  "policy": "canonical-validation-security-gate-v1",
  "stages": [
    {
      "order": 1,
      "id": "controlled-acquisition",
      "name": "Controlled Acquisition",
      "condition": "always",
      "failureAction": "BLOCK",
      "evidence": ["candidateIdentity", "authoritySnapshot", "sourcePin"]
    },
    {
      "order": 2,
      "id": "integrity-verification",
      "name": "Integrity Verification",
      "condition": "always",
      "failureAction": "BLOCK",
      "evidence": ["archiveSha256", "contentSha256", "provenance"]
    },
    {
      "order": 3,
      "id": "package-validation",
      "name": "Package Validation",
      "condition": "always",
      "failureAction": "BLOCK",
      "evidence": ["packageInventory", "packageSchema", "packageValidatorResult", "adapterResult", "skillToolsResult"]
    },
    {
      "order": 4,
      "id": "skillspector-static",
      "name": "SkillSpector Static",
      "condition": "always",
      "failureAction": "BLOCK",
      "evidence": ["scannerIdentity", "analyzerCompleteness", "staticReport"]
    },
    {
      "order": 5,
      "id": "repository-tests",
      "name": "Repository Tests",
      "condition": "always",
      "failureAction": "BLOCK",
      "evidence": ["testInventory", "testResult", "domainAdapterResult"]
    },
    {
      "order": 6,
      "id": "conditional-semantic-scan",
      "name": "Conditional Semantic Scan",
      "condition": "when-triggered",
      "failureAction": "BLOCK",
      "evidence": ["triggerDecision", "semanticReport", "semanticCompleteness"]
    },
    {
      "order": 7,
      "id": "ai-review",
      "name": "AI Review",
      "condition": "always",
      "failureAction": "BLOCK",
      "evidence": ["reviewFindings", "findingDisposition", "reviewedCandidate"]
    },
    {
      "order": 8,
      "id": "human-approval",
      "name": "Human Approval",
      "condition": "always",
      "failureAction": "BLOCK",
      "evidence": ["approver", "approvalTimestamp", "approvedCandidate"]
    },
    {
      "order": 9,
      "id": "publish-or-install",
      "name": "Publish / Install",
      "condition": "approved-release-or-authorized-install",
      "failureAction": "BLOCK",
      "evidence": ["releaseIdentity", "publishOrInstallResult", "authorization"]
    },
    {
      "order": 10,
      "id": "post-install-verification",
      "name": "Post-install Verification",
      "condition": "after-install",
      "failureAction": "BLOCK",
      "evidence": ["installedInventory", "installedManifest", "postInstallIntegrity"]
    }
  ],
  "security": {
    "scannerFailure": "BLOCK",
    "analyzerIncomplete": "BLOCK",
    "unparsableResult": "BLOCK",
    "unknownSeverity": "BLOCK",
    "severity": [
      {
        "level": "critical",
        "action": "BLOCK"
      },
      {
        "level": "high",
        "action": "BLOCK"
      },
      {
        "level": "medium",
        "action": "HUMAN_REVIEW_REQUIRED"
      },
      {
        "level": "low",
        "action": "RECORD_AND_TRACK"
      },
      {
        "level": "informational",
        "action": "RECORD_AND_TRACK"
      }
    ],
    "aiReviewCannotReplaceHumanApproval": true,
    "samePassBlockSemantics": ["local", "pre-push", "ci"]
  },
  "entryPointContract": {
    "canonicalExecution": {
      "maxPerEventCandidate": 1,
      "route": "canonical-validator",
      "sameCandidateBinding": true,
      "samePassBlockSemantics": true
    },
    "releaseAffectingSurfaces": {
      "workflowGlob": ".github/workflows/*.{yml,yaml}",
      "hookRoots": [".git/hooks", ".githooks"],
      "publicCommandFiles": ["README.md", "RELEASING.md", "RELEASE.md", "docs/RELEASE.md", "docs/RELEASING.md"],
      "mustRouteTo": "canonical-validator",
      "alternateGateAction": "BLOCK"
    },
    "componentScripts": {
      "mayExist": true,
      "mayBeTopLevelReleaseGate": false
    },
    "compatibilityLane": {
      "allowed": true,
      "requiresCanonicalDependency": true,
      "requiresRestrictedPurpose": true,
      "mayMirrorCanonicalResult": true,
      "mayRunIndependentPassBlockPolicy": false,
      "mayBeCanonicalReleaseGate": false
    },
    "triggerAdapters": {
      "allowedEvents": ["pull_request", "push", "workflow_dispatch"],
      "mustShareCanonicalValidator": true,
      "mustShareCandidateBinding": true,
      "duplicateEventCandidateExecution": false
    },
    "authorityWorkflowRoles": [
      {
        "path": ".github/workflows/standards-conformance.yml",
        "role": "canonical-authority-regression",
        "consumerAlternateGate": false
      },
      {
        "path": ".github/workflows/pr8-powershell-validation.yml",
        "role": "compatibility-and-linux-composition-bridge",
        "consumerAlternateGate": false
      },
      {
        "path": ".github/workflows/syp86-production-lock.yml",
        "role": "production-lock-contract",
        "consumerAlternateGate": false
      },
      {
        "path": ".github/workflows/syp101-production-smoke.yml",
        "role": "production-smoke-contract",
        "consumerAlternateGate": false
      }
    ]
  }
}
