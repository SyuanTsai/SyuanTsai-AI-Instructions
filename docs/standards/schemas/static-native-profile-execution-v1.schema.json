{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.test/standards/static-native-profile-execution-v1.schema.json",
  "title": "Unsigned execution record for an approved native SkillSpector report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "parserCorrection",
    "approvedSourceId",
    "signed",
    "authorizationGranted",
    "sourceRevision",
    "candidateIdentity",
    "officialScannerVersion",
    "officialScannerReleaseCommit",
    "wheelSha256",
    "analyzerSha256",
    "installedToolModified",
    "originalSourceFindingAnalyzerUnchanged",
    "scannerGraphExecuted",
    "scannerExitCode",
    "correctedReportSha256",
    "actualCompleteness",
    "applicabilityStatus",
    "executionProvenanceStatus",
    "authorizedOperations",
    "releaseEligible"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "profile": { "type": "string", "const": "none" },
    "parserCorrection": { "type": "string", "const": "none" },
    "approvedSourceId": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "signed": { "type": "boolean", "const": false },
    "authorizationGranted": { "type": "boolean", "const": false },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateIdentity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "officialScannerVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "officialScannerReleaseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "wheelSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "analyzerSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "installedToolModified": { "type": "boolean", "const": false },
    "originalSourceFindingAnalyzerUnchanged": { "type": "boolean", "const": true },
    "scannerGraphExecuted": { "type": "boolean", "const": true },
    "scannerExitCode": { "type": "integer", "const": 0 },
    "correctedReportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "actualCompleteness": { "type": "object" },
    "applicabilityStatus": { "type": "string", "const": "not-verified" },
    "executionProvenanceStatus": { "type": "string", "const": "not-verified" },
    "authorizedOperations": { "type": "array", "maxItems": 0 },
    "releaseEligible": { "type": "boolean", "const": false }
  }
}
