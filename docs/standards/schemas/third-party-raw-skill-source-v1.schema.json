{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Central adoption descriptor for an unmodified third-party raw Skill source",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "contract", "sourceId", "repository", "resolvedCommit", "archiveSha256", "reviewState", "reviewEvidence", "licenseReview", "licenseEvidence", "skills", "licenseDocuments"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contract": {"const": "third-party-raw-skill-source-v1"},
    "sourceId": {"$ref": "#/$defs/id"},
    "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"},
    "resolvedCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "archiveSha256": {"$ref": "#/$defs/hash"},
    "reviewState": {"enum": ["candidate", "approved"]},
    "reviewEvidence": {"$ref": "#/$defs/evidence"},
    "licenseReview": {"enum": ["pending", "accepted"]},
    "licenseEvidence": {"$ref": "#/$defs/evidence"},
    "skills": {"type": "array", "minItems": 1, "maxItems": 128, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourcePath", "targetPath", "contentSha256", "upstreamMetadata", "hostInterface"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sourcePath": {"type": "string", "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "targetPath": {"type": "string", "pattern": "^\\.agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "contentSha256": {"$ref": "#/$defs/hash"},
        "upstreamMetadata": {"type": "object", "additionalProperties": false, "required": ["sourceInventory", "openaiInterface"], "properties": {
          "sourceInventory": {"const": "absent"}, "openaiInterface": {"const": "absent"}
        }},
        "hostInterface": {"type": "object", "additionalProperties": false, "required": ["displayName", "shortDescription", "defaultPrompt"], "properties": {
          "displayName": {"type": "string", "minLength": 1, "maxLength": 128},
          "shortDescription": {"type": "string", "minLength": 25, "maxLength": 64},
          "defaultPrompt": {"type": "string", "minLength": 1, "maxLength": 2048}
        }}
      }
    }},
    "licenseDocuments": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {
        "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {"type": "array", "uniqueItems": true, "maxItems": 128, "items": {"type": "string", "minLength": 1, "pattern": "^https://"}}
  }
}
