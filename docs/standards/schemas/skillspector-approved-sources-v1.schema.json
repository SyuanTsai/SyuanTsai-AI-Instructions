{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.test/standards/skillspector-approved-sources-v1.schema.json",
  "title": "Approved SkillSpector release sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "source", "active", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "policy": { "type": "string", "const": "skillspector-approved-sources-v1" },
    "source": { "type": "string", "const": "NVIDIA/SkillSpector" },
    "active": { "$ref": "#/definitions/semver" },
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$": { "$ref": "#/definitions/entry" }
      }
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "releaseTag", "releaseCommit", "wheelFileName", "wheelSha256", "analyzerSha256", "parserCorrection"],
      "properties": {
        "kind": { "type": "string", "const": "pypi-release" },
        "version": { "$ref": "#/definitions/semver" },
        "releaseTag": { "type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
        "releaseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "wheelFileName": { "type": "string", "pattern": "^skillspector-(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-py3-none-any\\.whl$" },
        "wheelSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "analyzerSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "parserCorrection": { "type": "string", "enum": ["none", "powershell-native-command-ownership-v1"] }
      }
    }
  }
}
