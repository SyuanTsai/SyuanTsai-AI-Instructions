{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SyuanTsai/SyuanTsai-AI-Instructions/blob/main/docs/standards/schemas/standard-core-adapter-v2.schema.json",
  "title": "Standard ordinary core adapter v2",
  "description": "Minimal local repository-check dispatch for the default central runner path. It contains no external tool slots, provenance receipts, provider inputs, lifecycle stages, or approval claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adapter", "skillsRoot", "activeSkills", "checks"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "adapter": { "const": "standard-core-adapter-v2" },
    "skillsRoot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(^|/)\\.\\.?(/|$))(?!.*[\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"
    },
    "activeSkills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
    },
    "sourceValidation": {"type": "object", "additionalProperties": false, "required": ["packageAdapter", "skillValidator", "skillTools", "staticAnalyzer", "frozenFiles", "toolReceipts"], "properties": {"packageAdapter": {"$ref": "#/$defs/sourceCommand"}, "skillValidator": {"$ref": "#/$defs/sourceCommand"}, "skillTools": {"$ref": "#/$defs/sourceCommand"}, "staticAnalyzer": {"$ref": "#/$defs/sourceCommand"}, "frozenFiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frozenFile"}}, "testOwnership": {"const": "central-third-party-raw-skill-v1"}, "toolReceipts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/frozenFile"}}}},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "sourceCommand": {"type": "object", "additionalProperties": false, "required": ["command", "arguments"], "properties": {"command": {"type": "string", "minLength": 1}, "arguments": {"type": "array", "items": {"type": "string"}}}},
    "frozenFile": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "executable", "executableSha256", "arguments"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "kind": { "enum": ["general", "pester"] },
        "executable": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute, canonical executable path within the explicitly selected TrustedToolRoot; the runner verifies regular-file identity and SHA-256 before and after execution."
        },
        "executableSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "arguments": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
