{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed Skill lifecycle evidence v1",
  "description": "The central Standard v1 machine-readable ownership, failure, and transaction evidence records for managed replacement and legacy migration.",
  "oneOf": [
    { "$ref": "#/$defs/ownershipEvidence" },
    { "$ref": "#/$defs/failureDetail" },
    { "$ref": "#/$defs/transactionJournal" }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*\\u0000)(?!.*[\\u0001-\\u001f\\u007f])(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
    },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "classification": {
      "type": "string",
      "enum": ["managed", "known-legacy", "unmanaged-unknown", "managed-drift", "controlled-candidate"]
    },
    "ownershipEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "skillId",
        "path",
        "classification",
        "owner",
        "evidence",
        "destructiveChangeAllowed",
        "operation"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "skillId": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "classification": { "$ref": "#/$defs/classification" },
        "owner": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "destructiveChangeAllowed": { "type": "boolean" },
        "operation": { "enum": ["observe", "install", "replace", "remove", "adopt", "preserve"] }
      }
    },
    "failureDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "code",
        "skillId",
        "path",
        "classification",
        "owner",
        "evidence",
        "destructiveChangeAllowed",
        "backupCreated",
        "expectedSha256",
        "actualSha256",
        "remediation"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "code": { "type": "string", "minLength": 1 },
        "skillId": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "classification": { "$ref": "#/$defs/classification" },
        "owner": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "destructiveChangeAllowed": { "type": "boolean" },
        "backupCreated": { "type": "boolean" },
        "expectedSha256": { "$ref": "#/$defs/sha256" },
        "actualSha256": { "$ref": "#/$defs/sha256" },
        "remediation": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "transactionJournal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "transactionId",
        "userHome",
        "backupPath",
        "phase",
        "desiredManifestSha256",
        "desiredInventorySha256",
        "states"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "transactionId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "userHome": { "type": "string", "minLength": 1 },
        "backupPath": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["prepared", "mutating"] },
        "desiredManifestSha256": { "$ref": "#/$defs/sha256" },
        "desiredInventorySha256": { "$ref": "#/$defs/sha256" },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transactionState" }
        }
      }
    },
    "transactionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "existed",
        "backupPath",
        "originalSha256",
        "backupSha256",
        "appliedSha256"
      ],
      "properties": {
        "relativePath": { "$ref": "#/$defs/repositoryPath" },
        "existed": { "type": "boolean" },
        "backupPath": { "type": ["string", "null"] },
        "originalSha256": { "$ref": "#/$defs/sha256" },
        "backupSha256": { "$ref": "#/$defs/sha256" },
        "appliedSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
