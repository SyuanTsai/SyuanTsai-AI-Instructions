{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Skill source inventory v2",
  "description": "Strict semantic shape for a Standard v1 catalog/source.json. Repository identity binding, ordinal sorting, and directory equality are executable cross-document checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "repository",
    "skillsRoot",
    "skills"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sourceId": {
      "$ref": "#/$defs/stableId"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9._-]+\\.git$"
    },
    "skillsRoot": {
      "const": "skills"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
