{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical validation and security gate v1",
  "description": "Strict machine-readable stage order and fail-closed security semantics for Standard v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "stages", "security", "entryPointContract"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "const": "canonical-validation-security-gate-v1"
    },
    "stages": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "entryPointContract": {
      "$ref": "#/$defs/entryPointContract"
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "name", "condition", "failureAction", "evidence"],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "failureAction": {
          "enum": ["BLOCK", "HUMAN_REVIEW_REQUIRED", "RECORD_AND_TRACK"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "id": { "const": "controlled-acquisition" },
                "evidence": { "const": ["candidateIdentity", "authoritySnapshot", "sourcePin"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "integrity-verification" },
                "evidence": { "const": ["archiveSha256", "contentSha256", "provenance"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "package-validation" },
                "evidence": { "const": ["packageInventory", "packageSchema", "packageValidatorResult", "adapterResult", "skillToolsResult"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "skillspector-static" },
                "evidence": { "const": ["scannerIdentity", "analyzerCompleteness", "staticReport"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "repository-tests" },
                "evidence": { "const": ["testInventory", "testResult", "domainAdapterResult"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "conditional-semantic-scan" },
                "evidence": { "const": ["triggerDecision", "semanticReport", "semanticCompleteness"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "ai-review" },
                "evidence": { "const": ["reviewFindings", "findingDisposition", "reviewedCandidate"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "human-approval" },
                "evidence": { "const": ["approver", "approvalTimestamp", "approvedCandidate"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "publish-or-install" },
                "evidence": { "const": ["releaseIdentity", "publishOrInstallResult", "authorization", "attestation"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "post-install-verification" },
                "evidence": { "const": ["installedInventory", "installedManifest", "postInstallIntegrity", "attestation"] }
              }
            }
          ]
        }
      ]
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "action"],
      "properties": {
        "level": {
          "enum": ["critical", "high", "medium", "low", "informational"]
        },
        "action": {
          "enum": ["BLOCK", "HUMAN_REVIEW_REQUIRED", "RECORD_AND_TRACK"]
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scannerFailure",
        "analyzerIncomplete",
        "unparsableResult",
        "unknownSeverity",
        "severity",
        "aiReviewCannotReplaceHumanApproval",
        "samePassBlockSemantics"
      ],
      "properties": {
        "scannerFailure": {
          "const": "BLOCK"
        },
        "analyzerIncomplete": {
          "const": "BLOCK"
        },
        "unparsableResult": {
          "const": "BLOCK"
        },
        "unknownSeverity": {
          "const": "BLOCK"
        },
        "severity": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/severity"
          }
        },
        "aiReviewCannotReplaceHumanApproval": {
          "const": true
        },
        "samePassBlockSemantics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["local", "pre-push", "ci"]
          }
        }
      }
    },
    "entryPointContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalExecution",
        "releaseAffectingSurfaces",
        "componentScripts",
        "compatibilityLane",
        "triggerAdapters",
        "authorityWorkflowRoles"
      ],
      "properties": {
        "canonicalExecution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxPerEventCandidate", "route", "sameCandidateBinding", "samePassBlockSemantics"],
          "properties": {
            "maxPerEventCandidate": { "const": 1 },
            "route": { "const": "canonical-validator" },
            "sameCandidateBinding": { "const": true },
            "samePassBlockSemantics": { "const": true }
          }
        },
        "releaseAffectingSurfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflowGlob", "hookRoots", "publicCommandFiles", "mustRouteTo", "alternateGateAction", "requiresFailurePropagation", "forbiddenFailureSuppression"],
          "properties": {
            "workflowGlob": { "const": ".github/workflows/*.{yml,yaml}" },
            "hookRoots": { "const": [".git/hooks", ".githooks"] },
            "publicCommandFiles": { "const": ["README.md", "RELEASING.md", "RELEASE.md", "docs/RELEASE.md", "docs/RELEASING.md"] },
            "mustRouteTo": { "const": "canonical-validator" },
            "alternateGateAction": { "const": "BLOCK" },
            "requiresFailurePropagation": { "const": true },
            "forbiddenFailureSuppression": { "const": ["|| true", "|| :", "continue-on-error: true", "if: always()"] }
          }
        },
        "componentScripts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mayExist", "mayBeTopLevelReleaseGate"],
          "properties": {
            "mayExist": { "const": true },
            "mayBeTopLevelReleaseGate": { "const": false }
          }
        },
        "compatibilityLane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "requiresCanonicalDependency", "requiresRestrictedPurpose", "mayMirrorCanonicalResult", "mayRunIndependentPassBlockPolicy", "mayBeCanonicalReleaseGate"],
          "properties": {
            "allowed": { "const": true },
            "requiresCanonicalDependency": { "const": true },
            "requiresRestrictedPurpose": { "const": true },
            "mayMirrorCanonicalResult": { "const": true },
            "mayRunIndependentPassBlockPolicy": { "const": false },
            "mayBeCanonicalReleaseGate": { "const": false }
          }
        },
        "triggerAdapters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedEvents", "mustShareCanonicalValidator", "mustShareCandidateBinding", "duplicateEventCandidateExecution"],
          "properties": {
            "allowedEvents": { "const": ["pull_request", "push", "workflow_dispatch"] },
            "mustShareCanonicalValidator": { "const": true },
            "mustShareCandidateBinding": { "const": true },
            "duplicateEventCandidateExecution": { "const": false }
          }
        },
        "authorityWorkflowRoles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authorityWorkflowRole" }
        }
      }
    },
    "authorityWorkflowRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "consumerAlternateGate"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.(?:yml|yaml)$" },
        "role": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "consumerAlternateGate": { "const": false }
      }
    }
  }
}
