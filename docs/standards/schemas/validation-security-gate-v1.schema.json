{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical validation and security gate v1",
  "description": "Strict machine-readable stage order and fail-closed security semantics for Standard v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "stages", "security", "entryPointContract", "ordinaryAuthority"],
  "properties": {
    "ordinaryAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pesterVersion",
        "testPaths",
        "skippedCount",
        "externalToolAcquisition",
        "processBoundary",
        "unixIsolation",
        "limitations"
      ],
      "properties": {
        "pesterVersion": {
          "const": "4.10.1"
        },
        "testPaths": {
          "const": [
            "tests/internal-source-continuation.Tests.ps1",
            "tests/skill-repository-standard.Tests.ps1",
            "tests/skill-repository-workflows.Tests.ps1",
            "tests/standard-authority-entry-preflight.Tests.ps1",
            "tests/standard-entry-point-binding.Tests.ps1",
            "tests/standard-core-pester-adapter.Tests.ps1"
          ]
        },
        "skippedCount": {
          "const": 0
        },
        "externalToolAcquisition": {
          "const": false
        },
        "processBoundary": {
          "const": "platform-runtime-p3"
        },
        "unixIsolation": {
          "const": "cooperative"
        },
        "limitations": {
          "const": [
            "A1: same-account malicious concurrent writers are outside the protection boundary"
          ]
        }
      }
    },
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "const": "canonical-validation-security-gate-v1"
    },
    "stages": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "entryPointContract": {
      "$ref": "#/$defs/entryPointContract"
    }
  },
  "$defs": {
    "preparationProcessOwnership": {
      "description": "Supplemental preparation diagnostics; not a release attestation. Paths bind the selected launcher and leased physical executable. Success requires complete owned cleanup.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "commandPath",
        "resolvedCommandPath",
        "pid",
        "startIdentity",
        "isolation",
        "isolationCapability",
        "limitations",
        "cleanup"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "commandPath": {
          "type": "string",
          "minLength": 1
        },
        "resolvedCommandPath": {
          "type": "string",
          "minLength": 1
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "startIdentity": {
          "type": "string",
          "minLength": 1
        },
        "isolation": {
          "enum": [
            "windows-job-object",
            "linux-process-group-subreaper",
            "macos-process-group"
          ]
        },
        "isolationCapability": {
          "enum": [
            "strong",
            "cooperative"
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "CleanedUp",
            "Isolation",
            "Limitations",
            "Uncertainty",
            "SignalsSent",
            "RemainingPids",
            "UnixObservation",
            "CaptureReadersStopped",
            "CaptureResourcesClosed"
          ],
          "properties": {
            "CleanedUp": {
              "const": true
            },
            "Isolation": {
              "type": "string"
            },
            "Limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "Uncertainty": {
              "type": "null"
            },
            "SignalsSent": {
              "type": "integer",
              "minimum": 0
            },
            "RemainingPids": {
              "const": []
            },
            "UnixObservation": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "RootInventory",
                    "ExitInventory",
                    "WaitBinding",
                    "ExitCodeSource",
                    "WaitIdResult",
                    "WaitIdPid",
                    "WaitIdErrno",
                    "WaitPidResult",
                    "WaitPidErrno",
                    "KqueueExitStatus",
                    "GroupProbeErrno",
                    "RootReserved",
                    "InventoryComplete",
                    "GroupSignalsSent"
                  ],
                  "properties": {
                    "RootInventory": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ExitInventory": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "WaitBinding": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ExitCodeSource": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "WaitIdResult": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "WaitIdPid": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "WaitIdErrno": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "WaitPidResult": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "WaitPidErrno": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "KqueueExitStatus": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "GroupProbeErrno": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "RootReserved": {
                      "type": "boolean"
                    },
                    "InventoryComplete": {
                      "type": "boolean"
                    },
                    "GroupSignalsSent": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "CaptureReadersStopped": {
              "const": true
            },
            "CaptureResourcesClosed": {
              "const": true
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "isolation": {
                "const": "windows-job-object"
              }
            }
          },
          "then": {
            "properties": {
              "isolationCapability": {
                "const": "strong"
              }
            }
          },
          "else": {
            "properties": {
              "isolationCapability": {
                "const": "cooperative"
              }
            }
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "name", "condition", "failureAction", "evidence"],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "failureAction": {
          "enum": ["BLOCK", "HUMAN_REVIEW_REQUIRED", "RECORD_AND_TRACK"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "platformUnavailableException": {
          "$ref": "#/$defs/platformUnavailableException"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "id": { "const": "controlled-acquisition" },
                "evidence": { "const": ["candidateIdentity", "authoritySnapshot", "sourcePin"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "integrity-verification" },
                "evidence": { "const": ["archiveSha256", "contentSha256", "provenance"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "package-validation" },
                "evidence": { "const": ["packageInventory", "packageSchema", "packageValidatorResult", "adapterResult", "skillToolsResult"] }
              }
            },
            {
              "type": "object",
              "required": ["platformUnavailableException"],
              "properties": {
                "id": { "const": "skillspector-static" },
                "evidence": { "const": ["scannerIdentity", "analyzerCompleteness", "staticReport"] },
                "platformUnavailableException": { "$ref": "#/$defs/platformUnavailableException" }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "repository-tests" },
                "evidence": { "const": ["testInventory", "testResult", "domainAdapterResult"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "conditional-semantic-scan" },
                "evidence": { "const": ["triggerDecision", "semanticReport", "semanticCompleteness"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "ai-review" },
                "evidence": { "const": ["reviewFindings", "findingDisposition", "reviewedCandidate"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "human-approval" },
                "evidence": { "const": ["approver", "approvalTimestamp", "approvedCandidate"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "publish-or-install" },
                "evidence": { "const": ["releaseIdentity", "publishOrInstallResult", "authorization", "attestation"] }
              }
            },
            {
              "type": "object",
              "properties": {
                "id": { "const": "post-install-verification" },
                "evidence": { "const": ["installedInventory", "installedManifest", "postInstallIntegrity", "attestation"] }
              }
            }
          ]
        },
        {
          "if": {
            "properties": { "id": { "not": { "const": "skillspector-static" } } },
            "required": ["id"]
          },
          "then": { "not": { "required": ["platformUnavailableException"] } }
        }
      ]
    },
    "platformUnavailableException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "eligiblePlatforms",
        "windowsRequired",
        "requiredEvidence",
        "acceptedFailureKinds",
        "rejectedFailureKinds",
        "scannerPassed",
        "coverageComplete",
        "releaseEligible"
      ],
      "properties": {
        "status": { "const": "platform-unavailable" },
        "eligiblePlatforms": { "const": ["linux", "macos"] },
        "windowsRequired": { "const": true },
        "requiredEvidence": { "const": ["platform", "runtimeIdentity", "toolIdentity", "attemptedCommand", "rawResult", "failureKind", "incompatibilityReason"] },
        "acceptedFailureKinds": { "const": ["runtime-unsupported", "tool-platform-unsupported", "executable-format-unsupported"] },
        "rejectedFailureKinds": { "const": ["scan-failure", "missing-configuration", "timeout", "findings"] },
        "scannerPassed": { "const": false },
        "coverageComplete": { "const": false },
        "releaseEligible": { "const": false }
      }
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "action"],
      "properties": {
        "level": {
          "enum": ["critical", "high", "medium", "low", "informational"]
        },
        "action": {
          "enum": ["BLOCK", "HUMAN_REVIEW_REQUIRED", "RECORD_AND_TRACK"]
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scannerFailure",
        "analyzerIncomplete",
        "internalSourceContinuation",
        "unparsableResult",
        "unknownSeverity",
        "severity",
        "aiReviewCannotReplaceHumanApproval",
        "samePassBlockSemantics",
        "childProcessEnvironment",
        "outputReservation",
        "semanticTrigger",
        "semanticEvidence",
        "semanticPreflight",
        "semanticBridgeV2",
        "aiReview",
        "trustAnchors"
      ],
      "properties": {
        "scannerFailure": {
          "const": "BLOCK"
        },
        "analyzerIncomplete": {
          "const": "BLOCK"
        },
        "internalSourceContinuation": {
          "$ref": "#/$defs/internalSourceContinuation"
        },
        "unparsableResult": {
          "const": "BLOCK"
        },
        "unknownSeverity": {
          "const": "BLOCK"
        },
        "severity": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/severity"
          }
        },
        "aiReviewCannotReplaceHumanApproval": {
          "const": true
        },
        "samePassBlockSemantics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["local", "pre-push", "ci"]
          }
        },
        "childProcessEnvironment": {
          "$ref": "#/$defs/childProcessEnvironment"
        },
        "outputReservation": {
          "$ref": "#/$defs/outputReservation"
        },
        "semanticTrigger": {
          "$ref": "#/$defs/semanticTrigger"
        },
        "semanticEvidence": {
          "$ref": "#/$defs/semanticEvidence"
        },
        "semanticPreflight": {
          "$ref": "#/$defs/semanticPreflight"
        },
        "semanticBridgeV2": {
          "$ref": "#/$defs/semanticBridgeV2"
        },
        "aiReview": {
          "$ref": "#/$defs/aiReview"
        },
        "trustAnchors": {
          "$ref": "#/$defs/trustAnchors"
        }
      }
    },
    "internalSourceContinuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyPath",
        "authorityOwnership",
        "consumerSelfDeclaration",
        "canonicalFailurePreserved",
        "technicalResult",
        "publishable",
        "releaseEligible",
        "scope",
        "applicabilityStatus",
        "executionProvenanceStatus",
        "authorizationGranted",
        "authorizedOperations",
        "forbiddenOperations",
        "deferredIntegration"
      ],
      "properties": {
        "policyPath": {
          "const": "docs/standards/internal-source-continuation.json"
        },
        "authorityOwnership": {
          "const": "central-only"
        },
        "consumerSelfDeclaration": {
          "const": false
        },
        "canonicalFailurePreserved": {
          "const": true
        },
        "technicalResult": {
          "const": "evidence-consistency-only"
        },
        "publishable": {
          "const": false
        },
        "releaseEligible": {
          "const": false
        },
        "scope": {
          "const": "internal-review-only"
        },
        "applicabilityStatus": {
          "const": "not-verified"
        },
        "executionProvenanceStatus": {
          "const": "not-verified"
        },
        "authorizationGranted": {
          "const": false
        },
        "authorizedOperations": {
          "const": []
        },
        "forbiddenOperations": {
          "const": [
            "source-merge",
            "release",
            "install",
            "publish",
            "catalog-adoption"
          ]
        },
        "deferredIntegration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "consumerAuthority",
            "protectedBindings"
          ],
          "properties": {
            "status": {
              "const": "inactive"
            },
            "consumerAuthority": {
              "const": false
            },
            "protectedBindings": {
              "const": [
                "eventRepository",
                "eventSourceRevision",
                "canonicalRunId",
                "launchBinding",
                "candidateAcquisition",
                "authorityRevision",
                "scannerToolReceipt",
                "staticRawEvent",
                "supplementalTestInventory",
                "supplementalRawEvents",
                "cleanup",
                "humanFindingDispositionReview",
                "centralRevision",
                "workflowRevision",
                "authorityArchiveSha256"
              ]
            }
          }
        }
      }
    },
    "childProcessEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inheritance", "allowed", "forbidden"],
      "properties": {
        "inheritance": { "const": "clear-before-launch" },
        "allowed": { "const": ["approved-os-runtime", "STANDARD_VALIDATION_*"] },
        "forbidden": { "const": "arbitrary-inherited-secrets" }
      }
    },
    "outputReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredBeforeChildProcess", "ownership", "substitutionAction"],
      "properties": {
        "requiredBeforeChildProcess": { "const": true },
        "ownership": { "const": "supervisor-exclusive-handle" },
        "substitutionAction": { "const": "BLOCK" }
      }
    },
    "semanticTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzerProperty", "effectiveDecision", "recorded"],
      "properties": {
        "analyzerProperty": { "const": "semanticRequired" },
        "effectiveDecision": { "const": "callerRequested-OR-analyzerRequired" },
        "recorded": { "const": true }
      }
    },
    "semanticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authentication", "requiredFields", "success"],
      "properties": {
        "authentication": { "const": "trusted-supervisor-signed-semantic-v1" },
        "requiredFields": { "const": ["provider", "purpose", "scope", "consentGranted", "analyzerIdentity", "analyzerCompleteness", "findings", "findingsSha256"] },
        "success": { "const": ["status=passed", "decision=PASS", "consentGranted=true", "analyzerCompleteness=complete", "findings=array", "findingsSha256=verified"] }
      }
    },
    "semanticPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "authentication", "sourceBinding", "providerInventoryBinding", "workBinding", "jsonPropertyBinding", "requiredFields", "fixedState", "nonAuthority"],
      "properties": {
        "artifactType": { "const": "semantic-scan-preflight-v1" },
        "authentication": { "const": "unsigned-provider-output" },
        "sourceBinding": { "const": "llm-input-equals-strict-utf8-decoding-of-verified-source-bytes" },
        "providerInventoryBinding": { "const": "full-byte-manifest-plus-authenticated-provider-text-subset-with-strict-utf8-v1-digest" },
        "workBinding": { "const": "one-successful-provider-call-per-planned-work-item-with-matching-analyzer-path-and-interval" },
        "jsonPropertyBinding": { "const": "reject-decoded-duplicate-properties-with-ordinal-ignore-case-semantics-before-deserialization" },
        "requiredFields": { "const": ["candidateId", "inputInventorySha256", "providerTextInventorySha256", "scanOutputSha256", "provider", "purpose", "scope", "activeSkills", "analyzerIdentity", "analyzerCompleteness", "analyzerInventoryVerified", "findings", "findingsSha256", "severityGate", "consentStatus", "signed", "releaseEligible"] },
        "fixedState": { "const": ["analyzerInventoryVerified=false", "consentStatus=pending", "signed=false", "releaseEligible=false"] },
        "nonAuthority": { "const": ["cannot-satisfy-semantic-evidence", "cannot-authorize-release"] }
      }
    },
    "semanticBridgeV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "schemaPath",
        "artifactClassification",
        "artifactTypes",
        "mode",
        "callbackTrust",
        "filesystemIsolation",
        "callerSupplied",
        "nonSelected",
        "production",
        "v1Compatibility"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "schemaPath": { "const": "docs/standards/schemas/standard-semantic-consent-evidence-v2.schema.json" },
        "artifactClassification": { "const": "local-semantic-bridge-v2" },
        "artifactTypes": { "const": ["semantic-consent-request-v2", "semantic-consent-decision-v2", "semantic-evidence-v2"] },
        "mode": { "const": "development-harness-local-simulation-only" },
        "callbackTrust": { "const": "caller-trusted-local-code" },
        "filesystemIsolation": { "const": false },
        "callerSupplied": { "$ref": "#/$defs/semanticBridgeCallerSupplied" },
        "nonSelected": { "const": ["provider", "accountOrTenant", "model", "endpoint", "signer"] },
        "production": { "$ref": "#/$defs/semanticBridgeProductionBoundary" },
        "v1Compatibility": { "$ref": "#/$defs/semanticBridgeV1Compatibility" }
      }
    },
    "semanticBridgeCallerSupplied": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerRoute", "verificationKey", "providerCallback", "signerCallback"],
      "properties": {
        "providerRoute": { "const": true },
        "verificationKey": { "const": true },
        "providerCallback": { "const": true },
        "signerCallback": { "const": true }
      }
    },
    "semanticBridgeProductionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "releaseEligible", "failureAction", "pending"],
      "properties": {
        "active": { "const": false },
        "releaseEligible": { "const": false },
        "failureAction": { "const": "BLOCK" },
        "pending": { "const": ["protected-trust-anchor", "trusted-supervisor-authorization"] }
      }
    },
    "semanticBridgeV1Compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalAuthentication", "preserved", "v2SatisfiesV1"],
      "properties": {
        "canonicalAuthentication": { "const": "trusted-supervisor-signed-semantic-v1" },
        "preserved": { "const": true },
        "v2SatisfiesV1": { "const": false }
      }
    },
    "aiReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision", "candidateBinding", "arrayFields", "equalCounts", "severityPolicy", "authentication", "digestFields", "attestation"],
      "properties": {
        "status": { "const": "passed" },
        "decision": { "const": "PASS" },
        "candidateBinding": { "const": "reviewedCandidate" },
        "arrayFields": { "const": ["reviewFindings", "findingDisposition"] },
        "equalCounts": { "const": true },
        "severityPolicy": { "const": "central" },
        "authentication": { "const": "trusted-supervisor-signed-ai-review-v1" },
        "digestFields": { "const": ["reviewFindingsSha256", "findingDispositionSha256"] },
        "attestation": { "const": "trusted-supervisor-ai-review-v1" }
      }
    },
    "trustAnchors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "supervisorPublicKey", "humanApprovalPublicKey", "pinnedHashes"],
      "properties": {
        "root": { "const": "docs/standards/trust-anchors" },
        "supervisorPublicKey": { "const": "trusted-supervisor-public-key.xml" },
        "humanApprovalPublicKey": { "const": "human-approval-public-key.xml" },
        "pinnedHashes": { "const": true }
      }
    },
    "entryPointContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalExecution",
        "releaseAffectingSurfaces",
        "publicCommandDocumentation",
        "componentScripts",
        "compatibilityLane",
        "triggerAdapters",
        "authorityWorkflowRoles"
      ],
      "properties": {
        "canonicalExecution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxPerEventCandidate", "route", "sameCandidateBinding", "samePassBlockSemantics"],
          "properties": {
            "maxPerEventCandidate": { "const": 1 },
            "route": { "const": "canonical-validator" },
            "sameCandidateBinding": { "const": true },
            "samePassBlockSemantics": { "const": true }
          }
        },
        "releaseAffectingSurfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflowGlob", "hookRoots", "publicCommandFiles", "mustRouteTo", "alternateGateAction", "requiresFailurePropagation", "forbiddenFailureSuppression"],
          "properties": {
            "workflowGlob": { "const": ".github/workflows/*.{yml,yaml}" },
            "hookRoots": { "const": [".git/hooks", ".githooks"] },
            "publicCommandFiles": { "const": ["README.md", "RELEASING.md", "RELEASE.md", "docs/RELEASE.md", "docs/RELEASING.md"] },
            "mustRouteTo": { "const": "canonical-validator" },
            "alternateGateAction": { "const": "BLOCK" },
            "requiresFailurePropagation": { "const": true },
            "forbiddenFailureSuppression": { "const": ["|| true", "|| :", "continue-on-error: true", "if: always()"] }
          }
        },
        "publicCommandDocumentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "commandScope", "unrelatedCanonicalAuthorizesRelease", "setupAndDiagnosticsAreReleaseGates"],
          "properties": {
            "mode": { "const": "consistency-only" },
            "commandScope": { "const": "local-markdown-command-section" },
            "unrelatedCanonicalAuthorizesRelease": { "const": false },
            "setupAndDiagnosticsAreReleaseGates": { "const": false }
          }
        },
        "componentScripts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mayExist", "mayBeTopLevelReleaseGate"],
          "properties": {
            "mayExist": { "const": true },
            "mayBeTopLevelReleaseGate": { "const": false }
          }
        },
        "compatibilityLane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "requiresCanonicalDependency", "requiresRestrictedPurpose", "mayMirrorCanonicalResult", "mayRunIndependentPassBlockPolicy", "mayBeCanonicalReleaseGate"],
          "properties": {
            "allowed": { "const": true },
            "requiresCanonicalDependency": { "const": true },
            "requiresRestrictedPurpose": { "const": true },
            "mayMirrorCanonicalResult": { "const": true },
            "mayRunIndependentPassBlockPolicy": { "const": false },
            "mayBeCanonicalReleaseGate": { "const": false }
          }
        },
        "triggerAdapters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedEvents", "mustShareCanonicalValidator", "mustShareCandidateBinding", "duplicateEventCandidateExecution", "candidateKey", "overlappingFilterAction"],
          "properties": {
            "allowedEvents": { "const": ["pull_request", "push", "workflow_dispatch"] },
            "mustShareCanonicalValidator": { "const": true },
            "mustShareCandidateBinding": { "const": true },
            "duplicateEventCandidateExecution": { "const": false },
            "candidateKey": { "const": "event-only" },
            "overlappingFilterAction": { "const": "BLOCK" }
          }
        },
        "authorityWorkflowRoles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authorityWorkflowRole" }
        }
      }
    },
    "authorityWorkflowRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "consumerAlternateGate"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.(?:yml|yaml)$" },
        "role": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "consumerAlternateGate": { "const": false }
      }
    }
  }
}
