{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SyuanTsai/SyuanTsai-AI-Instructions/blob/main/docs/standards/schemas/standard-core-evidence-v2.schema.json",
  "title": "Standard ordinary core validation evidence v2",
  "description": "Local execution evidence only. A PASS records the actual checks and remains release-ineligible; it is not CI, scanner, release, or platform evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidence", "generatedAt", "runId", "state", "exitCode", "releaseEligible", "contentMode", "candidate", "authority", "adapter", "checks", "artifacts", "failure"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "evidence": { "const": "standard-core-validation-evidence-v2" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "state": { "enum": ["PASS", "BLOCKED", "FAILED", "INVALID", "CANCELLED"] },
    "exitCode": { "type": "integer", "enum": [0, 10, 20, 30, 40] },
    "releaseEligible": { "const": false },
    "contentMode": { "enum": ["immutable-source", "development"] },
    "candidate": { "oneOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }] },
    "authority": { "oneOf": [{ "$ref": "#/$defs/authority" }, { "type": "null" }] },
    "adapter": { "oneOf": [{ "$ref": "#/$defs/adapter" }, { "type": "null" }] },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "artifacts": { "oneOf": [{ "$ref": "#/$defs/artifacts" }, { "type": "null" }] },
    "sourceValidation": {"type": "object", "additionalProperties": false, "required": ["status", "runId", "candidateId", "sourceRevision", "contentSha256", "authorityRevision", "activeSkills", "scannerStatus", "coverageComplete", "platformUnavailableEvidence", "toolReceipts", "frozenFiles", "events", "skillsRoot", "adapterSnapshot"], "properties": {"status": {"const": "passed"}, "runId": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "candidateId": {"$ref": "#/$defs/sha256"}, "sourceRevision": {"$ref": "#/$defs/revision"}, "contentSha256": {"$ref": "#/$defs/sha256"}, "authorityRevision": {"$ref": "#/$defs/revision"}, "activeSkills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "scannerStatus": {"enum": ["passed", "platform-unavailable"]}, "coverageComplete": {"type": "boolean"}, "platformUnavailableEvidence": {"oneOf": [{"$ref": "#/$defs/platformUnavailableEvidence"}, {"type": "null"}]}, "testOwnership": {"const": "central-third-party-raw-skill-v1"}, "toolReceipts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/sourceFrozenFile"}}, "frozenFiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceFrozenFile"}}, "events": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/sourceEvent"}}, "skillsRoot": {"type": "string", "minLength": 1}, "pesterCaseInventory": {"$ref": "#/$defs/sourceFrozenFile"}, "adapterSnapshot": {"$ref": "#/$defs/sourceFrozenFile"}}, "allOf": [{"if": {"properties": {"scannerStatus": {"const": "platform-unavailable"}}, "required": ["scannerStatus"]}, "then": {"properties": {"coverageComplete": {"const": false}, "platformUnavailableEvidence": {"$ref": "#/$defs/platformUnavailableEvidence"}}}}, {"if": {"properties": {"scannerStatus": {"const": "passed"}}, "required": ["scannerStatus"]}, "then": {"properties": {"coverageComplete": {"const": true}, "platformUnavailableEvidence": {"type": "null"}}}}]},
    "failure": { "oneOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }] }
  },
  "allOf": [
    { "if": { "required": ["sourceValidation"], "properties": { "state": { "const": "PASS" } } }, "then": { "properties": { "sourceValidation": { "required": ["pesterCaseInventory"] } } } },
    { "if": { "properties": { "state": { "const": "PASS" } }, "required": ["state"] }, "then": { "properties": { "exitCode": { "const": 0 }, "candidate": { "$ref": "#/$defs/candidate" }, "authority": { "$ref": "#/$defs/authority" }, "adapter": { "$ref": "#/$defs/adapter" }, "checks": { "minItems": 1, "items": { "$ref": "#/$defs/passedCheck" } }, "artifacts": { "$ref": "#/$defs/artifacts" }, "failure": { "type": "null" } } } },
    { "if": { "properties": { "state": { "const": "BLOCKED" } }, "required": ["state"] }, "then": { "properties": { "exitCode": { "const": 10 }, "failure": { "$ref": "#/$defs/failure" } } } },
    { "if": { "properties": { "state": { "const": "FAILED" } }, "required": ["state"] }, "then": { "properties": { "exitCode": { "const": 20 }, "failure": { "$ref": "#/$defs/failure" } } } },
    { "if": { "properties": { "state": { "const": "INVALID" } }, "required": ["state"] }, "then": { "properties": { "exitCode": { "const": 30 }, "failure": { "$ref": "#/$defs/failure" } } } },
    { "if": { "properties": { "state": { "const": "CANCELLED" } }, "required": ["state"] }, "then": { "properties": { "exitCode": { "const": 40 }, "failure": { "$ref": "#/$defs/failure" } } } }
  ],
  "$defs": {
    "processOwnership": {
      "type": ["object", "null"],
      "description": "P2/P3 dispatch binding. Absent only for historical evidence or imported non-process events. Null cannot attest shared-runtime execution.",
      "additionalProperties": false,
      "required": ["processId", "startIdentity", "isolation", "isolationLevel", "limitations", "terminationReason", "cleanup", "runtime"],
      "properties": {
        "processId": {"type": ["integer", "null"], "minimum": 1},
        "startIdentity": {"type": ["string", "null"]},
        "isolation": {"enum": [null, "windows-job-object", "linux-process-group-subreaper", "macos-process-group"]},
        "isolationLevel": {"enum": [null, "strong", "cooperative"]},
        "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}, "allOf": [{"contains": {"const": "same-account-adversarial-writer-out-of-scope"}}, {"contains": {"const": "no-filesystem-isolation"}}]},
        "terminationReason": {"type": ["string", "null"]},
        "cleanup": {"type": ["object", "null"], "required": ["CleanedUp", "Isolation", "Limitations", "Uncertainty", "SignalsSent", "RemainingPids", "UnixObservation", "CaptureReadersStopped", "CaptureResourcesClosed"], "additionalProperties": false, "properties": {"CleanedUp": {"type": "boolean"}, "Isolation": {"type": "string"}, "Limitations": {"type": "array", "items": {"type": "string"}}, "Uncertainty": {"type": ["string", "null"]}, "SignalsSent": {"type": "integer", "minimum": 0}, "RemainingPids": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "UnixObservation": {"type": ["object", "null"]}, "CaptureReadersStopped": {"type": "boolean"}, "CaptureResourcesClosed": {"type": "boolean"}}},
        "runtime": {"type": ["object", "null"], "additionalProperties": false, "required": ["apiVersion", "manifestSha256", "powerShellVersion"], "properties": {"apiVersion": {"const": "1.0"}, "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "powerShellVersion": {"type": "string", "minLength": 1}}}
      },
      "allOf": [{"if": {"type": "object", "properties": {"isolation": {"const": "windows-job-object"}}}, "then": {"properties": {"isolationLevel": {"const": "strong"}}}}, {"if": {"type": "object", "properties": {"isolation": {"enum": ["linux-process-group-subreaper", "macos-process-group"]}}}, "then": {"properties": {"isolationLevel": {"const": "cooperative"}}}}, {"if": {"type": "object", "properties": {"isolation": {"type": "null"}}}, "then": {"properties": {"isolationLevel": {"type": "null"}}}}],
      "examples": [{"processId": 123, "startIdentity": "example-start-identity", "isolation": "windows-job-object", "isolationLevel": "strong", "limitations": ["same-account-adversarial-writer-out-of-scope", "no-filesystem-isolation"], "terminationReason": "cancelled", "cleanup": {"CleanedUp": true, "Isolation": "windows-job-object", "Limitations": [], "Uncertainty": null, "SignalsSent": 1, "RemainingPids": [], "UnixObservation": null, "CaptureReadersStopped": true, "CaptureResourcesClosed": true}, "runtime": {"apiVersion": "1.0", "manifestSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "powerShellVersion": "7.6.6"}}, {"processId": 123, "startIdentity": "example-start-identity", "isolation": "linux-process-group-subreaper", "isolationLevel": "cooperative", "limitations": ["same-account-adversarial-writer-out-of-scope", "no-filesystem-isolation", "group-signal-external-reaper-race"], "terminationReason": "cancelled", "cleanup": {"CleanedUp": true, "Isolation": "linux-process-group-subreaper", "Limitations": ["group-signal-external-reaper-race"], "Uncertainty": null, "SignalsSent": 1, "RemainingPids": [], "UnixObservation": null, "CaptureReadersStopped": true, "CaptureResourcesClosed": true}, "runtime": {"apiVersion": "1.0", "manifestSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "powerShellVersion": "7.6.6"}}, {"processId": 123, "startIdentity": "example-start-identity", "isolation": "macos-process-group", "isolationLevel": "cooperative", "limitations": ["same-account-adversarial-writer-out-of-scope", "no-filesystem-isolation", "macos-process-group-cannot-detect-setsid-escape", "group-signal-external-reaper-race"], "terminationReason": "cancelled", "cleanup": {"CleanedUp": true, "Isolation": "macos-process-group", "Limitations": ["macos-process-group-cannot-detect-setsid-escape", "group-signal-external-reaper-race"], "Uncertainty": null, "SignalsSent": 1, "RemainingPids": [], "UnixObservation": null, "CaptureReadersStopped": true, "CaptureResourcesClosed": true}, "runtime": {"apiVersion": "1.0", "manifestSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "powerShellVersion": "7.6.6"}}]
    },
    "sourceFrozenFile": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "sourceEvent": {"type": "object", "additionalProperties": false, "required": ["eventId", "stageId", "toolId", "candidateId", "commandSha256", "exitCode", "status", "outputSha256", "outputPath", "cleanedUp"], "properties": {"eventId": {"type": "string", "format": "uuid"}, "stageId": {"type": "string", "minLength": 1}, "toolId": {"type": "string", "minLength": 1}, "skillId": {"type": ["string", "null"]}, "candidateId": {"$ref": "#/$defs/sha256"}, "commandSha256": {"$ref": "#/$defs/sha256"}, "exitCode": {"type": "integer"}, "status": {"enum": ["passed", "failed", "startup-failed", "timeout", "cancelled", "cleanup-failed", "invalid-output", "platform-unavailable"]}, "outputSha256": {"$ref": "#/$defs/sha256"}, "outputPath": {"type": "string", "minLength": 1}, "cleanedUp": {"type": "boolean"}, "processOwnership": {"$ref": "#/$defs/processOwnership"}}},
    "platformUnavailableEvidence": {"type": "object", "additionalProperties": false, "required": ["platform", "runtimeIdentity", "toolIdentity", "attemptedCommand", "rawResult", "failureKind", "incompatibilityReason", "scannerPassed", "coverageComplete", "scannerExecuted", "releaseEligible"], "properties": {"platform": {"enum": ["linux", "macos"]}, "runtimeIdentity": {"type": "string", "minLength": 1}, "toolIdentity": {"type": "string", "minLength": 1}, "attemptedCommand": {"type": "string", "minLength": 1}, "rawResult": {"type": "string", "minLength": 1}, "failureKind": {"enum": ["runtime-unsupported", "tool-platform-unsupported", "executable-format-unsupported"]}, "incompatibilityReason": {"type": "string", "minLength": 1}, "scannerPassed": {"const": false}, "coverageComplete": {"const": false}, "scannerExecuted": {"const": false}, "releaseEligible": {"const": false}}},
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "inventoryEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "length"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(^|/)\\.\\.?(/|$))(?!.*[\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "length": { "type": "integer", "minimum": 0 }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "sourceRevision", "baseRevision", "contentSha256", "inventory", "activeSkills", "contentMode", "eventName"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "sourceRevision": { "$ref": "#/$defs/revision" },
        "baseRevision": { "$ref": "#/$defs/revision" },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "inventory": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inventoryEntry" } },
        "activeSkills": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" } },
        "contentMode": { "enum": ["immutable-source", "development"] },
        "eventName": { "enum": ["local", "pre-push", "pull_request", "push", "workflow_dispatch"] }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "runnerSha256", "contractSha256", "contentMode"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "revision": { "$ref": "#/$defs/revision" },
        "runnerSha256": { "$ref": "#/$defs/sha256" },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "contentMode": { "enum": ["source", "development"] }
      }
    },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "identity", "sha256"],
      "properties": { "schemaVersion": { "const": 2 }, "identity": { "const": "standard-core-adapter-v2" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "executableSha256", "argumentsSha256", "processId", "startedAt", "endedAt", "exitCode", "status", "cleanedUp", "stdoutPath", "stdoutSha256", "stderrPath", "stderrSha256", "testCounts"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "kind": { "enum": ["general", "pester"] },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "argumentsSha256": { "$ref": "#/$defs/sha256" },
        "processId": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "exitCode": { "type": "integer", "minimum": -1 },
        "status": { "enum": ["passed", "failed", "timeout", "cancelled", "startup-failed", "cleanup-failed"] },
        "cleanedUp": { "type": "boolean" },
        "processOwnership": { "$ref": "#/$defs/processOwnership" },
        "stdoutPath": { "type": "string", "minLength": 1 },
        "stdoutSha256": { "$ref": "#/$defs/sha256" },
        "stderrPath": { "type": "string", "minLength": 1 },
        "stderrSha256": { "$ref": "#/$defs/sha256" },
        "testCounts": { "oneOf": [{ "$ref": "#/$defs/testCounts" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "pester" } }, "required": ["kind"] }, "then": { "properties": { "testCounts": { "$ref": "#/$defs/testCounts" } } } },
        { "if": { "properties": { "kind": { "const": "general" } }, "required": ["kind"] }, "then": { "properties": { "testCounts": { "type": "null" } } } }
      ]
    },
    "passedCheck": {
      "allOf": [
        { "$ref": "#/$defs/check" },
        { "type": "object", "properties": { "exitCode": { "const": 0 }, "status": { "const": "passed" }, "cleanedUp": { "const": true } } }
      ]
    },
    "testCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "passed", "failed", "skipped"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 1 },
        "failed": { "const": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "root", "outputPath", "runRoot", "snapshotRoot"],
      "properties": {
        "runId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "root": { "type": "string", "minLength": 1 },
        "outputPath": { "type": "string", "minLength": 1 },
        "runRoot": { "type": "string", "minLength": 1 },
        "snapshotRoot": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "message"],
      "properties": { "state": { "enum": ["BLOCKED", "FAILED", "INVALID", "CANCELLED"] }, "message": { "type": "string", "minLength": 1 } }
    }
  }
}
