{
  "schemaVersion": 1,
  "policy": "latest-stable-per-validation-run",
  "sourceTrust": {
    "enforcement": "exact-approved-source",
    "resolver": "scripts/Resolve-StandardValidationTool.ps1",
    "failClosedOnMismatch": true
  },
  "resolution": {
    "resolveAtRunStart": true,
    "freezeForRun": true,
    "recordResolvedVersion": true,
    "recordResolvedIdentityWhenAvailable": true,
    "allowPrerelease": false
  },
  "tools": {
    "skillspector": {
      "source": "NVIDIA/SkillSpector",
      "channel": "latest-stable",
      "releaseVersionRule": "v-semver-release-only",
      "pythonPackageIndex": "https://pypi.org/simple",
      "pythonDistribution": {
        "configIsolation": "os.devnull",
        "environmentOverridePolicy": "deny-by-default",
        "allowedInheritedEnvironment": [
          "PIP_INDEX_URL"
        ],
        "rejectInheritedPythonEnvironment": true,
        "onlyBinary": true,
        "allowDirectReferences": false,
        "allowPipOnlineDependencyTraversal": false,
        "allowYanked": false,
        "disableCache": true,
        "candidateDiscovery": "approved-simple-json-lazy",
        "requiresPythonPolicy": "simple-json-wheel-metadata-normalized-specifier-set-current-interpreter",
        "dependencyAcquisition": "verified-wheelhouse",
        "dependencyResolver": "pip-offline-backtracking",
        "installEnvironment": "isolated-venv",
        "interpreterIsolation": "python-isolated-mode",
        "credentialIsolation": "github-token-cleared-before-python",
        "installedMetadataVerification": "static-dist-info-metadata",
        "verifyOfflineResolution": true,
        "installNoIndex": true,
        "requireHashes": true,
        "recordDependencyClosureHashes": true
      }
    },
    "skill-validator": {
      "source": "github.com/agent-ecosystem/skill-validator/cmd/skill-validator",
      "channel": "latest-stable",
      "stableVersionRule": "release-semver-only",
      "proxy": "https://proxy.golang.org",
      "checksumDatabase": "sum.golang.org",
      "goRuntimeVersion": "1.26.8",
      "goEnvironment": {
        "GOENV": "off",
        "GOPROXY": "https://proxy.golang.org",
        "GOSUMDB": "sum.golang.org",
        "GOPRIVATE": "",
        "GONOPROXY": "none",
        "GONOSUMDB": "none",
        "GOINSECURE": "",
        "GOFLAGS": "",
        "GOTOOLCHAIN": "local",
        "GOWORK": "off",
        "CGO_ENABLED": "0"
      },
      "goDistribution": {
        "moduleCacheIsolation": "temporary-empty",
        "buildCacheIsolation": "temporary-empty",
        "temporaryDirectoryIsolation": "temporary-empty",
        "binaryInstallIsolation": "run-owned",
        "rejectInheritedModuleCache": true,
        "rejectInheritedBuildCache": true,
        "rejectDangerousEnvironment": true,
        "recordBinaryHash": true
      }
    },
    "skill-tools": {
      "source": "npm:skill-tools",
      "registry": "https://registry.npmjs.org/",
      "channel": "latest-stable",
      "npmDistribution": {
        "configIsolation": "empty-config-and-workdir",
        "environmentOverridePolicy": "deny-by-default",
        "allowedInheritedEnvironment": [
          "NPM_CONFIG_REGISTRY"
        ],
        "dependencyAcquisition": "package-lock",
        "installEnvironment": "isolated-prefix",
        "ignoreScripts": true,
        "recordDependencyClosureIntegrity": true
      }
    },
    "pester": {
      "source": "PowerShellGallery:Pester",
      "channel": "latest-stable",
      "repository": "https://www.powershellgallery.com/api/v2"
    }
  },
  "compatibilityLane": {
    "mayPinOlderVersion": true,
    "requiresExplicitPurpose": true,
    "mayBeCanonicalReleaseGate": false
  }
}
