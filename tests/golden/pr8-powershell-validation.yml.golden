name: PowerShell Regression

on:
  push:
    branches:
      - syp-79-multi-source-routing
      - syp-86
      - syp-101
      - main
  pull_request:
    branches:
      - syp-86
      - main
    # This required workflow always runs the complete retained source-test plan.
  workflow_dispatch:

concurrency:
  group: powershell-regression-${{ github.event_name }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

jobs:
  plan:
    name: Windows Core plan
    runs-on: windows-latest
    timeout-minutes: 15
    permissions:
      contents: read
    outputs:
      matrix: ${{ steps.plan.outputs.matrix }}
      planSha256: ${{ steps.plan.outputs.planSha256 }}
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Restore verified PowerShell archive cache
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ${{ runner.temp }}/pwsh-cache/PowerShell-7.6.6-win-x64.zip
          key: pwsh-zip-${{ runner.os }}-7.6.6-02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860

      - name: Install verified latest stable PowerShell
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $version = '7.6.6'
          $expectedSha256 = '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860'
          $archivePath = Join-Path $env:RUNNER_TEMP 'PowerShell-7.6.6-win-x64.zip'
          $installDirectory = Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6'
          $cachePath = Join-Path $env:RUNNER_TEMP 'pwsh-cache/PowerShell-7.6.6-win-x64.zip'
          $downloadUri = 'https://github.com/PowerShell/PowerShell/releases/download/v7.6.6/PowerShell-7.6.6-win-x64.zip'
          if ((Test-Path -LiteralPath $archivePath) -or (Test-Path -LiteralPath $installDirectory)) { throw 'PowerShell setup paths must be new within this job.' }
          $cacheIsVerified = $false
          if (Test-Path -LiteralPath $cachePath) {
            $cacheItem = Get-Item -Force -LiteralPath $cachePath -ErrorAction Stop
            if ($cacheItem.PSIsContainer -or ($cacheItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
              Remove-Item -LiteralPath $cachePath -Force
            } else {
              $cacheSha256 = (Get-FileHash -LiteralPath $cachePath -Algorithm SHA256).Hash.ToUpperInvariant()
              if ($cacheSha256 -ceq $expectedSha256) {
                Copy-Item -LiteralPath $cachePath -Destination $archivePath
                $cacheIsVerified = $true
              } else {
                Remove-Item -LiteralPath $cachePath -Force
              }
            }
          }
          if (-not $cacheIsVerified) { Invoke-WebRequest -Uri $downloadUri -OutFile $archivePath }
          $actualSha256 = (Get-FileHash -LiteralPath $archivePath -Algorithm SHA256).Hash.ToUpperInvariant()
          if ($actualSha256 -cne $expectedSha256) { throw "PowerShell archive SHA256 mismatch: expected $expectedSha256, got $actualSha256." }
          if (-not $cacheIsVerified) {
            [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($cachePath)) | Out-Null
            Copy-Item -LiteralPath $archivePath -Destination $cachePath
          }
          Expand-Archive -LiteralPath $archivePath -DestinationPath $installDirectory
          $powerShellExe = Join-Path $installDirectory 'pwsh.exe'
          if (-not (Test-Path -LiteralPath $powerShellExe -PathType Leaf)) { throw 'Verified PowerShell archive did not contain pwsh.exe.' }
          $archiveRuntimeVersion = (& $powerShellExe -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()')
          if ($LASTEXITCODE -ne 0 -or ([string]$archiveRuntimeVersion).Trim() -cne $version) { throw "Verified archive launched unexpected PowerShell version '$archiveRuntimeVersion'." }
          [IO.File]::AppendAllText($env:GITHUB_PATH, $installDirectory + [Environment]::NewLine, [Text.UTF8Encoding]::new($false))
          $githubEnvironment = 'SYP_REQUIRED_PWSH_VERSION=' + $version + [Environment]::NewLine + 'SYP_REQUIRED_PWSH_SHA256=' + $expectedSha256 + [Environment]::NewLine
          [IO.File]::AppendAllText($env:GITHUB_ENV, $githubEnvironment, [Text.UTF8Encoding]::new($false))
          Write-Host "Resolved PowerShell $version from a SHA-256 verified ZIP; portable path: $powerShellExe"

      - name: Verify the selected PowerShell runtime
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $expectedExecutable = [IO.Path]::GetFullPath((Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6/pwsh.exe'))
          $selectedExecutable = [IO.Path]::GetFullPath((Get-Command pwsh -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source)
          $processExecutable = [IO.Path]::GetFullPath([Diagnostics.Process]::GetCurrentProcess().MainModule.FileName)
          $homeExecutable = [IO.Path]::GetFullPath((Join-Path $PSHOME 'pwsh.exe'))
          if (-not [string]::Equals($processExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase) -or
              -not [string]::Equals($homeExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) {
            throw "The actual GitHub step shell is not the verified portable PowerShell: process=$processExecutable PSHOME=$PSHOME"
          }
          if (-not [string]::Equals($selectedExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) { throw "The job shell did not select the verified portable runtime: $selectedExecutable" }
          if ($PSVersionTable.PSVersion.ToString() -cne $env:SYP_REQUIRED_PWSH_VERSION) { throw "Expected PowerShell $env:SYP_REQUIRED_PWSH_VERSION, running $($PSVersionTable.PSVersion)." }
          if ($env:SYP_REQUIRED_PWSH_SHA256 -cne '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860') { throw 'The verified PowerShell download hash binding changed.' }
          Write-Host "PowerShell runtime verified: $($PSVersionTable.PSVersion) at $selectedExecutable"

      - name: Ensure Pester 4.10.1
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $pesterModules = @(Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' })
          if ($pesterModules.Count -eq 0) {
            Install-Module Pester -RequiredVersion 4.10.1 -Scope CurrentUser -Force -SkipPublisherCheck
            $pesterModules = @(Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' })
          }
          if ($pesterModules.Count -ne 1) { throw "Expected exactly one Pester 4.10.1 module; found $($pesterModules.Count)." }
          $manifestPath = Join-Path ([string]$pesterModules[0].ModuleBase) 'Pester.psd1'
          $manifestItem = Get-Item -Force -LiteralPath $manifestPath
          if ($manifestItem.PSIsContainer -or ($manifestItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'Pester manifest must be a regular non-reparse file.' }
          $manifest = Import-PowerShellDataFile -LiteralPath $manifestPath -ErrorAction Stop
          if ([version]$manifest.ModuleVersion -ne [version]'4.10.1') { throw 'Installed Pester manifest is not version 4.10.1.' }

      - name: Calculate the Windows Core plan
        id: plan
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          & ./scripts/Get-WindowsCorePlan.ps1 -RepositoryRoot . -OutputPath (Join-Path $env:RUNNER_TEMP 'windows-core/plan.json')
          if (-not $?) { throw 'Windows Core planning failed.' }

      - name: Upload Windows Core plan
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
        with:
          name: windows-core-plan-${{ github.run_id }}
          path: |
            ${{ runner.temp }}/windows-core/plan.json
            ${{ runner.temp }}/windows-core/plan.sha256
          if-no-files-found: error
          retention-days: 1
          overwrite: true

  authority:
    name: Windows Core authority
    needs: plan
    runs-on: windows-latest
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Restore verified PowerShell archive cache
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ${{ runner.temp }}/pwsh-cache/PowerShell-7.6.6-win-x64.zip
          key: pwsh-zip-${{ runner.os }}-7.6.6-02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860

      - name: Install verified latest stable PowerShell
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $version = '7.6.6'
          $expectedSha256 = '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860'
          $archivePath = Join-Path $env:RUNNER_TEMP 'PowerShell-7.6.6-win-x64.zip'
          $installDirectory = Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6'
          $cachePath = Join-Path $env:RUNNER_TEMP 'pwsh-cache/PowerShell-7.6.6-win-x64.zip'
          $downloadUri = 'https://github.com/PowerShell/PowerShell/releases/download/v7.6.6/PowerShell-7.6.6-win-x64.zip'
          if ((Test-Path -LiteralPath $archivePath) -or (Test-Path -LiteralPath $installDirectory)) { throw 'PowerShell setup paths must be new within this job.' }
          $cacheIsVerified = $false
          if (Test-Path -LiteralPath $cachePath) {
            $cacheItem = Get-Item -Force -LiteralPath $cachePath -ErrorAction Stop
            if ($cacheItem.PSIsContainer -or ($cacheItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
              Remove-Item -LiteralPath $cachePath -Force
            } else {
              $cacheSha256 = (Get-FileHash -LiteralPath $cachePath -Algorithm SHA256).Hash.ToUpperInvariant()
              if ($cacheSha256 -ceq $expectedSha256) {
                Copy-Item -LiteralPath $cachePath -Destination $archivePath
                $cacheIsVerified = $true
              } else {
                Remove-Item -LiteralPath $cachePath -Force
              }
            }
          }
          if (-not $cacheIsVerified) { Invoke-WebRequest -Uri $downloadUri -OutFile $archivePath }
          $actualSha256 = (Get-FileHash -LiteralPath $archivePath -Algorithm SHA256).Hash.ToUpperInvariant()
          if ($actualSha256 -cne $expectedSha256) { throw "PowerShell archive SHA256 mismatch: expected $expectedSha256, got $actualSha256." }
          if (-not $cacheIsVerified) {
            [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($cachePath)) | Out-Null
            Copy-Item -LiteralPath $archivePath -Destination $cachePath
          }
          Expand-Archive -LiteralPath $archivePath -DestinationPath $installDirectory
          $powerShellExe = Join-Path $installDirectory 'pwsh.exe'
          if (-not (Test-Path -LiteralPath $powerShellExe -PathType Leaf)) { throw 'Verified PowerShell archive did not contain pwsh.exe.' }
          $archiveRuntimeVersion = (& $powerShellExe -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()')
          if ($LASTEXITCODE -ne 0 -or ([string]$archiveRuntimeVersion).Trim() -cne $version) { throw "Verified archive launched unexpected PowerShell version '$archiveRuntimeVersion'." }
          [IO.File]::AppendAllText($env:GITHUB_PATH, $installDirectory + [Environment]::NewLine, [Text.UTF8Encoding]::new($false))
          $githubEnvironment = 'SYP_REQUIRED_PWSH_VERSION=' + $version + [Environment]::NewLine + 'SYP_REQUIRED_PWSH_SHA256=' + $expectedSha256 + [Environment]::NewLine
          [IO.File]::AppendAllText($env:GITHUB_ENV, $githubEnvironment, [Text.UTF8Encoding]::new($false))
          Write-Host "Resolved PowerShell $version from a SHA-256 verified ZIP; portable path: $powerShellExe"

      - name: Verify the selected PowerShell runtime
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $expectedExecutable = [IO.Path]::GetFullPath((Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6/pwsh.exe'))
          $selectedExecutable = [IO.Path]::GetFullPath((Get-Command pwsh -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source)
          $processExecutable = [IO.Path]::GetFullPath([Diagnostics.Process]::GetCurrentProcess().MainModule.FileName)
          $homeExecutable = [IO.Path]::GetFullPath((Join-Path $PSHOME 'pwsh.exe'))
          if (-not [string]::Equals($processExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase) -or
              -not [string]::Equals($homeExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) {
            throw "The actual GitHub step shell is not the verified portable PowerShell: process=$processExecutable PSHOME=$PSHOME"
          }
          if (-not [string]::Equals($selectedExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) { throw "The job shell did not select the verified portable runtime: $selectedExecutable" }
          if ($PSVersionTable.PSVersion.ToString() -cne $env:SYP_REQUIRED_PWSH_VERSION) { throw "Expected PowerShell $env:SYP_REQUIRED_PWSH_VERSION, running $($PSVersionTable.PSVersion)." }
          if ($env:SYP_REQUIRED_PWSH_SHA256 -cne '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860') { throw 'The verified PowerShell download hash binding changed.' }
          Write-Host "PowerShell runtime verified: $($PSVersionTable.PSVersion) at $selectedExecutable"

      - name: Ensure Pester 4.10.1
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $pesterModules = @(Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' })
          if ($pesterModules.Count -eq 0) {
            Install-Module Pester -RequiredVersion 4.10.1 -Scope CurrentUser -Force -SkipPublisherCheck
            $pesterModules = @(Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' })
          }
          if ($pesterModules.Count -ne 1) { throw "Expected exactly one Pester 4.10.1 module; found $($pesterModules.Count)." }
          $manifestPath = Join-Path ([string]$pesterModules[0].ModuleBase) 'Pester.psd1'
          $manifestItem = Get-Item -Force -LiteralPath $manifestPath
          if ($manifestItem.PSIsContainer -or ($manifestItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'Pester manifest must be a regular non-reparse file.' }
          $manifest = Import-PowerShellDataFile -LiteralPath $manifestPath -ErrorAction Stop
          if ([version]$manifest.ModuleVersion -ne [version]'4.10.1') { throw 'Installed Pester manifest is not version 4.10.1.' }

      - name: Parse all PowerShell files
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $files = @(git ls-files '*.ps1' '*.psm1')
          if ($LASTEXITCODE -ne 0 -or $files.Count -eq 0) { throw 'Could not enumerate tracked PowerShell files.' }
          $failed = $false
          foreach ($file in $files) {
            $tokens = $null
            $errors = $null
            [void][System.Management.Automation.Language.Parser]::ParseFile((Resolve-Path $file), [ref]$tokens, [ref]$errors)
            foreach ($parseError in @($errors)) {
              $failed = $true
              Write-Host ("PARSE ERROR {0}:{1}:{2}: {3} [{4}]" -f $file, $parseError.Extent.StartLineNumber, $parseError.Extent.StartColumnNumber, $parseError.Message, $parseError.Extent.Text)
            }
          }
          if ($failed) { throw 'Tracked PowerShell files contain parse errors under the required PowerShell 7 runtime.' }

      - name: Check whitespace in the event range
        shell: pwsh
        env:
          PULL_REQUEST_BASE_SHA: ${{ github.event.pull_request.base.sha }}
          PUSH_BEFORE_SHA: ${{ github.event.before }}
        run: |
          $ErrorActionPreference = 'Stop'
          if ($env:GITHUB_EVENT_NAME -eq 'pull_request' -and $env:PULL_REQUEST_BASE_SHA -match '^[0-9a-f]{40}$') {
            git diff --check "$env:PULL_REQUEST_BASE_SHA...HEAD"
          } elseif ($env:GITHUB_EVENT_NAME -eq 'push' -and $env:PUSH_BEFORE_SHA -match '^[0-9a-f]{40}$' -and $env:PUSH_BEFORE_SHA -notmatch '^0+$') {
            git diff --check "$env:PUSH_BEFORE_SHA..HEAD"
          } else {
            $parent = (& git rev-parse --verify 'HEAD^' 2>$null)
            if ($LASTEXITCODE -eq 0 -and [string]$parent -match '^[0-9a-f]{40}$') { git diff --check 'HEAD^..HEAD' }
            else { git diff-tree --check --root -r HEAD }
          }
          if ($LASTEXITCODE -ne 0) { throw 'Whitespace check failed for the event commit range.' }

      - name: Run the Standard v1 authority gate
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $candidateRoot = [IO.Path]::GetFullPath((Get-Location).Path)
          $revision = (& git rev-parse --verify 'HEAD^{commit}').Trim()
          if ($LASTEXITCODE -ne 0 -or $revision -notmatch '^[0-9a-f]{40}$') { throw 'Could not resolve the full checked-out HEAD revision.' }
          & ./scripts/Invoke-StandardAuthorityGate.ps1 -ArtifactsRoot $env:RUNNER_TEMP -CandidateRoot $candidateRoot -AuthorityRoot $candidateRoot -CandidateRevision $revision -AuthorityRevision $revision -EventName $env:GITHUB_EVENT_NAME -ResultArtifact 'windows-core/authority-result.json'
          if (-not $?) { throw 'Standard v1 authority gate failed.' }

      - name: Upload Windows Core authority evidence
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
        with:
          name: windows-core-authority-${{ github.run_id }}
          path: |
            ${{ runner.temp }}/windows-core/authority-result.json
            ${{ runner.temp }}/syp325-source-scope-*/**/*.json
          if-no-files-found: warn
          retention-days: 1
          overwrite: true

  pester:
    name: Windows Core shard ${{ matrix.id }}
    needs: plan
    runs-on: windows-latest
    timeout-minutes: 75
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.plan.outputs.matrix) }}
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Restore verified PowerShell archive cache
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ${{ runner.temp }}/pwsh-cache/PowerShell-7.6.6-win-x64.zip
          key: pwsh-zip-${{ runner.os }}-7.6.6-02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860

      - name: Install verified latest stable PowerShell
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $version = '7.6.6'
          $expectedSha256 = '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860'
          $archivePath = Join-Path $env:RUNNER_TEMP 'PowerShell-7.6.6-win-x64.zip'
          $installDirectory = Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6'
          $cachePath = Join-Path $env:RUNNER_TEMP 'pwsh-cache/PowerShell-7.6.6-win-x64.zip'
          $downloadUri = 'https://github.com/PowerShell/PowerShell/releases/download/v7.6.6/PowerShell-7.6.6-win-x64.zip'
          if ((Test-Path -LiteralPath $archivePath) -or (Test-Path -LiteralPath $installDirectory)) { throw 'PowerShell setup paths must be new within this job.' }
          $cacheIsVerified = $false
          if (Test-Path -LiteralPath $cachePath) {
            $cacheItem = Get-Item -Force -LiteralPath $cachePath -ErrorAction Stop
            if ($cacheItem.PSIsContainer -or ($cacheItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
              Remove-Item -LiteralPath $cachePath -Force
            } else {
              $cacheSha256 = (Get-FileHash -LiteralPath $cachePath -Algorithm SHA256).Hash.ToUpperInvariant()
              if ($cacheSha256 -ceq $expectedSha256) {
                Copy-Item -LiteralPath $cachePath -Destination $archivePath
                $cacheIsVerified = $true
              } else {
                Remove-Item -LiteralPath $cachePath -Force
              }
            }
          }
          if (-not $cacheIsVerified) { Invoke-WebRequest -Uri $downloadUri -OutFile $archivePath }
          $actualSha256 = (Get-FileHash -LiteralPath $archivePath -Algorithm SHA256).Hash.ToUpperInvariant()
          if ($actualSha256 -cne $expectedSha256) { throw "PowerShell archive SHA256 mismatch: expected $expectedSha256, got $actualSha256." }
          if (-not $cacheIsVerified) {
            [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($cachePath)) | Out-Null
            Copy-Item -LiteralPath $archivePath -Destination $cachePath
          }
          Expand-Archive -LiteralPath $archivePath -DestinationPath $installDirectory
          $powerShellExe = Join-Path $installDirectory 'pwsh.exe'
          if (-not (Test-Path -LiteralPath $powerShellExe -PathType Leaf)) { throw 'Verified PowerShell archive did not contain pwsh.exe.' }
          $archiveRuntimeVersion = (& $powerShellExe -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()')
          if ($LASTEXITCODE -ne 0 -or ([string]$archiveRuntimeVersion).Trim() -cne $version) { throw "Verified archive launched unexpected PowerShell version '$archiveRuntimeVersion'." }
          [IO.File]::AppendAllText($env:GITHUB_PATH, $installDirectory + [Environment]::NewLine, [Text.UTF8Encoding]::new($false))
          $githubEnvironment = 'SYP_REQUIRED_PWSH_VERSION=' + $version + [Environment]::NewLine + 'SYP_REQUIRED_PWSH_SHA256=' + $expectedSha256 + [Environment]::NewLine
          [IO.File]::AppendAllText($env:GITHUB_ENV, $githubEnvironment, [Text.UTF8Encoding]::new($false))
          Write-Host "Resolved PowerShell $version from a SHA-256 verified ZIP; portable path: $powerShellExe"

      - name: Verify the selected PowerShell runtime
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $expectedExecutable = [IO.Path]::GetFullPath((Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6/pwsh.exe'))
          $selectedExecutable = [IO.Path]::GetFullPath((Get-Command pwsh -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source)
          $processExecutable = [IO.Path]::GetFullPath([Diagnostics.Process]::GetCurrentProcess().MainModule.FileName)
          $homeExecutable = [IO.Path]::GetFullPath((Join-Path $PSHOME 'pwsh.exe'))
          if (-not [string]::Equals($processExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase) -or
              -not [string]::Equals($homeExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) {
            throw "The actual GitHub step shell is not the verified portable PowerShell: process=$processExecutable PSHOME=$PSHOME"
          }
          if (-not [string]::Equals($selectedExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) { throw "The job shell did not select the verified portable runtime: $selectedExecutable" }
          if ($PSVersionTable.PSVersion.ToString() -cne $env:SYP_REQUIRED_PWSH_VERSION) { throw "Expected PowerShell $env:SYP_REQUIRED_PWSH_VERSION, running $($PSVersionTable.PSVersion)." }
          if ($env:SYP_REQUIRED_PWSH_SHA256 -cne '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860') { throw 'The verified PowerShell download hash binding changed.' }
          Write-Host "PowerShell runtime verified: $($PSVersionTable.PSVersion) at $selectedExecutable"

      - name: Ensure Pester 4.10.1
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $pesterModules = @(Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' })
          if ($pesterModules.Count -eq 0) {
            Install-Module Pester -RequiredVersion 4.10.1 -Scope CurrentUser -Force -SkipPublisherCheck
            $pesterModules = @(Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' })
          }
          if ($pesterModules.Count -ne 1) { throw "Expected exactly one Pester 4.10.1 module; found $($pesterModules.Count)." }
          $manifestPath = Join-Path ([string]$pesterModules[0].ModuleBase) 'Pester.psd1'
          $manifestItem = Get-Item -Force -LiteralPath $manifestPath
          if ($manifestItem.PSIsContainer -or ($manifestItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'Pester manifest must be a regular non-reparse file.' }
          $manifest = Import-PowerShellDataFile -LiteralPath $manifestPath -ErrorAction Stop
          if ([version]$manifest.ModuleVersion -ne [version]'4.10.1') { throw 'Installed Pester manifest is not version 4.10.1.' }

      - name: Run the planned non-authority Pester shard
        shell: pwsh
        env:
          SHARD_ID: ${{ matrix.id }}
          SHARD_FILES_BASE64: ${{ matrix.filesBase64 }}
          SHARD_SKIPS_BASE64: ${{ matrix.skipsBase64 }}
        run: |
          $ErrorActionPreference = 'Stop'
          Remove-Module Pester -Force -ErrorAction SilentlyContinue
          $pester = Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' } | Select-Object -First 1
          if ($null -eq $pester) { throw 'Pester 4.10.1 is unavailable in the shard step.' }
          if ($env:SHARD_ID -notmatch '^[0-9]{2}$') { throw 'The shard id is invalid.' }
          try {
            $selectedTestNames = [string[]]@([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($env:SHARD_FILES_BASE64)) | ConvertFrom-Json)
            $expectedSkippedTests = [string[]]@([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($env:SHARD_SKIPS_BASE64)) | ConvertFrom-Json)
          }
          catch { throw "The shard matrix payload is invalid: $($_.Exception.Message)" }
          if ($selectedTestNames.Count -eq 0 -or @($selectedTestNames | Select-Object -Unique).Count -ne $selectedTestNames.Count) { throw 'The shard file list is empty or duplicated.' }
          $allTestFiles = @(Get-ChildItem -LiteralPath './tests' -Filter '*.Tests.ps1' -File -Recurse)
          foreach ($name in $selectedTestNames) {
            if ($name -notmatch '^[^/\\]+\.Tests\.ps1$') { throw "Unsafe shard test filename '$name'." }
            if (@($allTestFiles | Where-Object Name -ceq $name).Count -ne 1) { throw "Shard test filename must resolve exactly once: '$name'." }
          }
          . ./scripts/Invoke-StandardAuthorityGate.ps1 -DefineFunctionsOnly
          $inventoryRoot = [IO.Path]::GetFullPath((Get-Location).Path)
          $authorityNames = @(Get-AuthorityTestPaths -Root $inventoryRoot | ForEach-Object { [IO.Path]::GetFileName($_) })
          foreach ($name in $selectedTestNames) {
            if ($authorityNames -ccontains $name) { throw "Authority test cannot enter a Pester shard: '$name'." }
          }
          foreach ($identifier in $expectedSkippedTests) {
            if ($identifier -notmatch '^[^:/\\]+\.Tests\.ps1::\S.+$' -or $selectedTestNames -cnotcontains (($identifier -split '::', 2)[0])) {
              throw "Shard skip identifier is invalid or belongs to another shard: '$identifier'."
            }
          }
          $executorArguments = @{
            PesterModulePath = [string]$pester.Path
            PesterVersion = '4.10.1'
            ExpectedSkippedCount = $expectedSkippedTests.Count
            ExpectedSkippedTests = $expectedSkippedTests
            # Each selected file already runs in its own process, so repository-wide isolated defaults must not be reapplied inside a matrix shard.
            IsolatedTestFileNames = [string[]]@()
            BulkShardSize = 1
            ShardPartitionCount = 1
            ShardPartitionIndex = 0
            OuterTimeoutSeconds = 3600
            TestRoot = './tests'
            EvidenceRoot = $env:RUNNER_TEMP
            SelectedTestFileNames = $selectedTestNames
            SummaryOutputPath = (Join-Path $env:RUNNER_TEMP "windows-core-shard-$($env:SHARD_ID)-summary.json")
            SummarySchemaVersion = 2
            SummaryRunId = [string]$env:GITHUB_RUN_ID
            SummaryRunAttempt = [int]$env:GITHUB_RUN_ATTEMPT
          }
          & ./scripts/Invoke-PesterShardProcess.ps1 @executorArguments
          if (-not $?) { throw "The bounded non-authority Pester shard '$($env:SHARD_ID)' failed." }

      - name: Upload Windows Core shard evidence
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
        with:
          name: windows-core-shard-${{ matrix.id }}-${{ github.run_id }}
          path: |
            ${{ runner.temp }}/windows-core-shard-${{ matrix.id }}-summary.json
            ${{ runner.temp }}/pester-shard-*.json
            ${{ runner.temp }}/pester-shard-*.process.json
            ${{ runner.temp }}/pester-shard-*.stdout.log
            ${{ runner.temp }}/pester-shard-*.stderr.log
          if-no-files-found: warn
          retention-days: 1
          overwrite: true

  fixtures:
    name: Windows Core fixtures
    needs: plan
    runs-on: windows-latest
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Restore verified PowerShell archive cache
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ${{ runner.temp }}/pwsh-cache/PowerShell-7.6.6-win-x64.zip
          key: pwsh-zip-${{ runner.os }}-7.6.6-02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860

      - name: Install verified latest stable PowerShell
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $version = '7.6.6'
          $expectedSha256 = '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860'
          $archivePath = Join-Path $env:RUNNER_TEMP 'PowerShell-7.6.6-win-x64.zip'
          $installDirectory = Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6'
          $cachePath = Join-Path $env:RUNNER_TEMP 'pwsh-cache/PowerShell-7.6.6-win-x64.zip'
          $downloadUri = 'https://github.com/PowerShell/PowerShell/releases/download/v7.6.6/PowerShell-7.6.6-win-x64.zip'
          if ((Test-Path -LiteralPath $archivePath) -or (Test-Path -LiteralPath $installDirectory)) { throw 'PowerShell setup paths must be new within this job.' }
          $cacheIsVerified = $false
          if (Test-Path -LiteralPath $cachePath) {
            $cacheItem = Get-Item -Force -LiteralPath $cachePath -ErrorAction Stop
            if ($cacheItem.PSIsContainer -or ($cacheItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
              Remove-Item -LiteralPath $cachePath -Force
            } else {
              $cacheSha256 = (Get-FileHash -LiteralPath $cachePath -Algorithm SHA256).Hash.ToUpperInvariant()
              if ($cacheSha256 -ceq $expectedSha256) {
                Copy-Item -LiteralPath $cachePath -Destination $archivePath
                $cacheIsVerified = $true
              } else {
                Remove-Item -LiteralPath $cachePath -Force
              }
            }
          }
          if (-not $cacheIsVerified) { Invoke-WebRequest -Uri $downloadUri -OutFile $archivePath }
          $actualSha256 = (Get-FileHash -LiteralPath $archivePath -Algorithm SHA256).Hash.ToUpperInvariant()
          if ($actualSha256 -cne $expectedSha256) { throw "PowerShell archive SHA256 mismatch: expected $expectedSha256, got $actualSha256." }
          if (-not $cacheIsVerified) {
            [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($cachePath)) | Out-Null
            Copy-Item -LiteralPath $archivePath -Destination $cachePath
          }
          Expand-Archive -LiteralPath $archivePath -DestinationPath $installDirectory
          $powerShellExe = Join-Path $installDirectory 'pwsh.exe'
          if (-not (Test-Path -LiteralPath $powerShellExe -PathType Leaf)) { throw 'Verified PowerShell archive did not contain pwsh.exe.' }
          $archiveRuntimeVersion = (& $powerShellExe -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()')
          if ($LASTEXITCODE -ne 0 -or ([string]$archiveRuntimeVersion).Trim() -cne $version) { throw "Verified archive launched unexpected PowerShell version '$archiveRuntimeVersion'." }
          [IO.File]::AppendAllText($env:GITHUB_PATH, $installDirectory + [Environment]::NewLine, [Text.UTF8Encoding]::new($false))
          $githubEnvironment = 'SYP_REQUIRED_PWSH_VERSION=' + $version + [Environment]::NewLine + 'SYP_REQUIRED_PWSH_SHA256=' + $expectedSha256 + [Environment]::NewLine
          [IO.File]::AppendAllText($env:GITHUB_ENV, $githubEnvironment, [Text.UTF8Encoding]::new($false))
          Write-Host "Resolved PowerShell $version from a SHA-256 verified ZIP; portable path: $powerShellExe"

      - name: Verify the selected PowerShell runtime
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $expectedExecutable = [IO.Path]::GetFullPath((Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6/pwsh.exe'))
          $selectedExecutable = [IO.Path]::GetFullPath((Get-Command pwsh -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source)
          $processExecutable = [IO.Path]::GetFullPath([Diagnostics.Process]::GetCurrentProcess().MainModule.FileName)
          $homeExecutable = [IO.Path]::GetFullPath((Join-Path $PSHOME 'pwsh.exe'))
          if (-not [string]::Equals($processExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase) -or
              -not [string]::Equals($homeExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) {
            throw "The actual GitHub step shell is not the verified portable PowerShell: process=$processExecutable PSHOME=$PSHOME"
          }
          if (-not [string]::Equals($selectedExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) { throw "The job shell did not select the verified portable runtime: $selectedExecutable" }
          if ($PSVersionTable.PSVersion.ToString() -cne $env:SYP_REQUIRED_PWSH_VERSION) { throw "Expected PowerShell $env:SYP_REQUIRED_PWSH_VERSION, running $($PSVersionTable.PSVersion)." }
          if ($env:SYP_REQUIRED_PWSH_SHA256 -cne '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860') { throw 'The verified PowerShell download hash binding changed.' }
          Write-Host "PowerShell runtime verified: $($PSVersionTable.PSVersion) at $selectedExecutable"

      - name: Ensure Pester 4.10.1
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $pesterModules = @(Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' })
          if ($pesterModules.Count -eq 0) {
            Install-Module Pester -RequiredVersion 4.10.1 -Scope CurrentUser -Force -SkipPublisherCheck
            $pesterModules = @(Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' })
          }
          if ($pesterModules.Count -ne 1) { throw "Expected exactly one Pester 4.10.1 module; found $($pesterModules.Count)." }
          $manifestPath = Join-Path ([string]$pesterModules[0].ModuleBase) 'Pester.psd1'
          $manifestItem = Get-Item -Force -LiteralPath $manifestPath
          if ($manifestItem.PSIsContainer -or ($manifestItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'Pester manifest must be a regular non-reparse file.' }
          $manifest = Import-PowerShellDataFile -LiteralPath $manifestPath -ErrorAction Stop
          if ([version]$manifest.ModuleVersion -ne [version]'4.10.1') { throw 'Installed Pester manifest is not version 4.10.1.' }

      - name: Run isolated SYP-214 fixture evidence child
        shell: pwsh
        env:
          PULL_REQUEST_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: |
          $ErrorActionPreference = 'Stop'
          $PSNativeCommandUseErrorActionPreference = $false
          $pwshPath = [IO.Path]::GetFullPath((Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6/pwsh.exe'))
          if (-not (Test-Path -LiteralPath $pwshPath -PathType Leaf)) { throw 'Verified portable PowerShell is unavailable for the fixture child.' }
          $pwshVersion = (& $pwshPath -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()')
          if ($LASTEXITCODE -ne 0 -or ([string]$pwshVersion).Trim() -cne $env:SYP_REQUIRED_PWSH_VERSION) { throw 'Fixture child PowerShell identity does not match the verified runtime.' }
          $pester = Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' } | Select-Object -First 1
          if ($null -eq $pester) { throw 'Pester 4.10.1 is unavailable for the fixture child.' }
          $artifactRoot = Join-Path $env:RUNNER_TEMP 'syp214-fixture-evidence'
          $evidenceRoot = Join-Path $artifactRoot 'reports'
          New-Item -ItemType Directory -Force -Path $evidenceRoot | Out-Null
          $stdoutPath = Join-Path $artifactRoot 'child.stdout.log'
          $stderrPath = Join-Path $artifactRoot 'child.stderr.log'
          $summaryPath = Join-Path $artifactRoot 'pester-summary.json'
          $processResultPath = Join-Path $artifactRoot 'process-result.json'
          $childScriptPath = Join-Path $artifactRoot 'invoke-fixtures.ps1'
          $checkoutHead = (& git rev-parse --verify 'HEAD^{commit}').Trim()
          if ($LASTEXITCODE -ne 0 -or $checkoutHead -notmatch '^[0-9a-f]{40}$') { throw 'Could not resolve checked-out fixture commit.' }
          $checkoutTree = (& git rev-parse --verify 'HEAD^{tree}').Trim()
          if ($LASTEXITCODE -ne 0 -or $checkoutTree -notmatch '^[0-9a-f]{40}$') { throw 'Could not resolve checked-out fixture tree.' }
          $sourceHead = if ($env:PULL_REQUEST_HEAD_SHA -match '^[0-9a-f]{40}$') { $env:PULL_REQUEST_HEAD_SHA } else { $env:GITHUB_SHA }
          $testPath = [IO.Path]::GetFullPath('./tests/syp214-user-only.Tests.ps1')
          $bootstrapPath = [IO.Path]::GetFullPath('./scripts/bootstrap-ai-instructions.ps1')
          $testHash = (Get-FileHash -LiteralPath $testPath -Algorithm SHA256).Hash.ToLowerInvariant()
          $bootstrapHash = (Get-FileHash -LiteralPath $bootstrapPath -Algorithm SHA256).Hash.ToLowerInvariant()
          $env:SYP214_FIXTURE_EVIDENCE_ROOT = $evidenceRoot
          $env:SYP214_SOURCE_HEAD_SHA = $sourceHead
          $env:SYP214_CHECKOUT_HEAD_SHA = $checkoutHead
          $env:SYP214_CHECKOUT_TREE_SHA = $checkoutTree
          $env:SYP214_TEST_SCRIPT_SHA256 = $testHash
          $env:SYP214_BOOTSTRAP_SCRIPT_SHA256 = $bootstrapHash
          $env:SYP214_PESTER_VERSION = '4.10.1'
          $childScript = @'
          $ErrorActionPreference = 'Stop'
          $expectedCases = @(
            'migration.json', 'failure-rollback.json', 'recovery-exact.json',
            'recovery-later-edit.json', 'recovery-corrupt-backup.json', 'recovery-pending-intent.json'
          )
          $summary = [ordered]@{
            schemaVersion = 1; status = 'starting'; runId = [string]$env:GITHUB_RUN_ID
            runAttempt = [string]$env:GITHUB_RUN_ATTEMPT; sourceHeadCommit = [string]$env:SYP214_SOURCE_HEAD_SHA
            checkoutHeadCommit = [string]$env:SYP214_CHECKOUT_HEAD_SHA; checkoutTree = [string]$env:SYP214_CHECKOUT_TREE_SHA
            testScriptSha256 = [string]$env:SYP214_TEST_SCRIPT_SHA256; bootstrapScriptSha256 = [string]$env:SYP214_BOOTSTRAP_SCRIPT_SHA256
            pwshVersion = $PSVersionTable.PSVersion.ToString(); pwshExecutable = [IO.Path]::GetFullPath((Join-Path $PSHOME 'pwsh.exe'))
            pesterVersion = $null; total = $null; passed = $null; failed = $null; skipped = $null
            pending = $null; inconclusive = $null; observedCaseNames = @(); expectedEvidenceFiles = $expectedCases
            observedCases = @(); observedEvidenceFiles = @(); missingEvidenceFiles = @(); startedAtUtc = [DateTime]::UtcNow.ToString('o')
            completedAtUtc = $null; error = $null
          }
          try {
            $pester = @(Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' })
            if ($pester.Count -ne 1) { throw "Expected one Pester 4.10.1 module in child; found $($pester.Count)." }
            Import-Module $pester[0].Path -Force
            $summary.pesterVersion = (Get-Module Pester | Select-Object -First 1).Version.ToString()
            $run = Invoke-Pester -Script $env:SYP214_TEST_SCRIPT_PATH -Tag 'Syp214FixtureEvidence' -PassThru -Show Summary
            if ($null -eq $run) { throw 'Pester returned no result object for the isolated fixture run.' }
            $summary.total = [int]$run.TotalCount
            $summary.passed = [int]$run.PassedCount
            $summary.failed = [int]$run.FailedCount
            $summary.skipped = [int]$run.SkippedCount
            $summary.pending = [int]$run.PendingCount
            $summary.inconclusive = [int]$run.InconclusiveCount
            $summary.observedCases = @($run.TestResult | ForEach-Object {
              [ordered]@{ name = [string]$_.Name; result = [string]$_.Result; duration = [string]$_.Time; failureMessage = [string]$_.FailureMessage }
            })
            $summary.observedCaseNames = @($summary.observedCases | ForEach-Object { [string]$_.name })
            $reports = @(Get-ChildItem -LiteralPath $env:SYP214_FIXTURE_EVIDENCE_ROOT -File -Filter '*.json' | Sort-Object Name)
            $summary.observedEvidenceFiles = @($reports | ForEach-Object {
              [ordered]@{ name = $_.Name; length = [long]$_.Length; sha256 = (Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash.ToLowerInvariant() }
            })
            $actualNames = @($reports | ForEach-Object { $_.Name } | Sort-Object -CaseSensitive)
            $expectedNames = @($expectedCases | Sort-Object -CaseSensitive)
            $summary.missingEvidenceFiles = @($expectedCases | Where-Object { $actualNames -cnotcontains $_ })
            $caseInventoryValid = ($summary.total -eq 6 -and $summary.observedCaseNames.Count -eq 6 -and
              @($summary.observedCaseNames | Select-Object -Unique).Count -eq 6 -and
              @($summary.observedCaseNames | Where-Object { $_ -match '^InterT40_' }).Count -eq 1 -and
              @($summary.observedCaseNames | Where-Object { $_ -match '^InterT50_' }).Count -eq 1 -and
              @($summary.observedCaseNames | Where-Object { $_ -match '^InterT60_durable_recovery_' }).Count -eq 4)
            $reportInventoryValid = (($actualNames -join "`n") -ceq ($expectedNames -join "`n"))
            $allPassed = ($summary.passed -eq 6 -and $summary.failed -eq 0 -and $summary.skipped -eq 0 -and
              $summary.pending -eq 0 -and $summary.inconclusive -eq 0)
            if (-not $caseInventoryValid) { throw 'Observed Pester case names or counts differ from the six tagged SYP-214 fixtures.' }
            if (-not $reportInventoryValid) { throw 'Observed fixture JSON files do not equal the six expected evidence reports.' }
            if (-not $allPassed) { throw 'The isolated SYP-214 Pester fixture run did not pass all six cases.' }
            $summary.status = 'passed'
          }
          catch {
            $summary.status = 'failed'
            $summary.error = $_.Exception.Message
          }
          finally {
            $summary.completedAtUtc = [DateTime]::UtcNow.ToString('o')
            [IO.File]::WriteAllText($env:SYP214_PESTER_SUMMARY_PATH, ($summary | ConvertTo-Json -Depth 10) + "`n", [Text.UTF8Encoding]::new($false))
          }
          if ($summary.status -cne 'passed') { throw [string]$summary.error }
          '@
          [IO.File]::WriteAllText($childScriptPath, $childScript, [Text.UTF8Encoding]::new($false))
          $childScriptHash = (Get-FileHash -LiteralPath $childScriptPath -Algorithm SHA256).Hash.ToLowerInvariant()
          $env:SYP214_TEST_SCRIPT_PATH = $testPath
          $env:SYP214_PESTER_SUMMARY_PATH = $summaryPath
          $startedAt = [DateTime]::UtcNow.ToString('o')
          $childExitCode = $null
          $completionState = 'launch-failed'
          $launchError = $null
          try {
            & $pwshPath -NoLogo -NoProfile -File $childScriptPath 1> $stdoutPath 2> $stderrPath
            $childExitCode = $LASTEXITCODE
            $completionState = 'exited'
          }
          catch {
            $launchError = $_.Exception.Message
          }
          $completedAt = [DateTime]::UtcNow.ToString('o')
          $summaryExists = Test-Path -LiteralPath $summaryPath -PathType Leaf
          $processResult = [ordered]@{
            schemaVersion = 1; runId = [string]$env:GITHUB_RUN_ID; runAttempt = [string]$env:GITHUB_RUN_ATTEMPT
            workflow = [string]$env:GITHUB_WORKFLOW; event = [string]$env:GITHUB_EVENT_NAME; ref = [string]$env:GITHUB_REF
            sourceHeadCommit = $sourceHead; checkoutHeadCommit = $checkoutHead; checkoutTree = $checkoutTree
            command = @($pwshPath, '-NoLogo', '-NoProfile', '-File', $childScriptPath)
            childScriptSha256 = $childScriptHash; testScriptSha256 = $testHash; bootstrapScriptSha256 = $bootstrapHash
            pwshVersion = ([string]$pwshVersion).Trim(); pwshExecutable = $pwshPath
            verifiedPwshArchiveSha256 = [string]$env:SYP_REQUIRED_PWSH_SHA256; pesterVersion = '4.10.1'
            testScriptPath = $testPath; pesterTag = 'Syp214FixtureEvidence'
            startedAtUtc = $startedAt; completedAtUtc = $completedAt; completionState = $completionState
            childExitCode = $childExitCode; childExitStatus = $(if ($null -eq $childExitCode) { 'unknown' } elseif ($childExitCode -eq 0) { 'passed' } else { 'failed' })
            launchError = $launchError; summaryExists = $summaryExists
            summarySha256 = $(if ($summaryExists) { (Get-FileHash -LiteralPath $summaryPath -Algorithm SHA256).Hash.ToLowerInvariant() } else { $null })
            stdoutPath = $stdoutPath; stdoutLength = $(if (Test-Path -LiteralPath $stdoutPath -PathType Leaf) { [long](Get-Item -LiteralPath $stdoutPath).Length } else { $null })
            stdoutSha256 = $(if (Test-Path -LiteralPath $stdoutPath -PathType Leaf) { (Get-FileHash -LiteralPath $stdoutPath -Algorithm SHA256).Hash.ToLowerInvariant() } else { $null })
            stderrPath = $stderrPath; stderrLength = $(if (Test-Path -LiteralPath $stderrPath -PathType Leaf) { [long](Get-Item -LiteralPath $stderrPath).Length } else { $null })
            stderrSha256 = $(if (Test-Path -LiteralPath $stderrPath -PathType Leaf) { (Get-FileHash -LiteralPath $stderrPath -Algorithm SHA256).Hash.ToLowerInvariant() } else { $null })
            pesterSummaryPath = $summaryPath; evidenceRoot = $evidenceRoot
          }
          [IO.File]::WriteAllText($processResultPath, ($processResult | ConvertTo-Json -Depth 8) + "`n", [Text.UTF8Encoding]::new($false))
          if ($completionState -cne 'exited' -or $null -eq $childExitCode -or $childExitCode -ne 0 -or -not $summaryExists) { throw 'Isolated SYP-214 fixture evidence child failed or omitted its result summary.' }

      - name: Run offline routine semantic fixtures once
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          python -B -c "import sys; print(sys.version); raise SystemExit(0 if sys.version_info >= (3, 10) else 1)"
          if ($LASTEXITCODE -ne 0) { throw 'Offline fixtures require Python 3.10 or newer.' }
          python -B -c "import unittest; suite=unittest.defaultTestLoader.discover('tests', pattern='test_routine_semantic_*.py'); unittest.TestCase().assertEqual(suite.countTestCases(), 61, 'Exact offline fixture count changed'); result=unittest.TextTestRunner(verbosity=2).run(suite); raise SystemExit(0 if result.wasSuccessful() and len(result.skipped) == 0 else 1)"
          if ($LASTEXITCODE -ne 0) { throw 'Offline routine semantic fixtures failed or skipped.' }

      - name: Upload Windows Core fixture evidence
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
        with:
          name: windows-core-fixtures-${{ github.run_id }}
          path: |
            ${{ runner.temp }}/syp214-fixture-evidence/pester-summary.json
            ${{ runner.temp }}/syp214-fixture-evidence/process-result.json
            ${{ runner.temp }}/syp214-fixture-evidence/child.stdout.log
            ${{ runner.temp }}/syp214-fixture-evidence/child.stderr.log
            ${{ runner.temp }}/syp214-fixture-evidence/reports/*.json
          if-no-files-found: warn
          retention-days: 1
          overwrite: true

  windows-core:
    name: Windows Core
    needs: [plan, authority, pester, fixtures]
    if: always()
    runs-on: windows-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Restore verified PowerShell archive cache
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ${{ runner.temp }}/pwsh-cache/PowerShell-7.6.6-win-x64.zip
          key: pwsh-zip-${{ runner.os }}-7.6.6-02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860

      - name: Install verified latest stable PowerShell
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $version = '7.6.6'
          $expectedSha256 = '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860'
          $archivePath = Join-Path $env:RUNNER_TEMP 'PowerShell-7.6.6-win-x64.zip'
          $installDirectory = Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6'
          $cachePath = Join-Path $env:RUNNER_TEMP 'pwsh-cache/PowerShell-7.6.6-win-x64.zip'
          $downloadUri = 'https://github.com/PowerShell/PowerShell/releases/download/v7.6.6/PowerShell-7.6.6-win-x64.zip'
          if ((Test-Path -LiteralPath $archivePath) -or (Test-Path -LiteralPath $installDirectory)) { throw 'PowerShell setup paths must be new within this job.' }
          $cacheIsVerified = $false
          if (Test-Path -LiteralPath $cachePath) {
            $cacheItem = Get-Item -Force -LiteralPath $cachePath -ErrorAction Stop
            if ($cacheItem.PSIsContainer -or ($cacheItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
              Remove-Item -LiteralPath $cachePath -Force
            } else {
              $cacheSha256 = (Get-FileHash -LiteralPath $cachePath -Algorithm SHA256).Hash.ToUpperInvariant()
              if ($cacheSha256 -ceq $expectedSha256) {
                Copy-Item -LiteralPath $cachePath -Destination $archivePath
                $cacheIsVerified = $true
              } else {
                Remove-Item -LiteralPath $cachePath -Force
              }
            }
          }
          if (-not $cacheIsVerified) { Invoke-WebRequest -Uri $downloadUri -OutFile $archivePath }
          $actualSha256 = (Get-FileHash -LiteralPath $archivePath -Algorithm SHA256).Hash.ToUpperInvariant()
          if ($actualSha256 -cne $expectedSha256) { throw "PowerShell archive SHA256 mismatch: expected $expectedSha256, got $actualSha256." }
          if (-not $cacheIsVerified) {
            [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($cachePath)) | Out-Null
            Copy-Item -LiteralPath $archivePath -Destination $cachePath
          }
          Expand-Archive -LiteralPath $archivePath -DestinationPath $installDirectory
          $powerShellExe = Join-Path $installDirectory 'pwsh.exe'
          if (-not (Test-Path -LiteralPath $powerShellExe -PathType Leaf)) { throw 'Verified PowerShell archive did not contain pwsh.exe.' }
          $archiveRuntimeVersion = (& $powerShellExe -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()')
          if ($LASTEXITCODE -ne 0 -or ([string]$archiveRuntimeVersion).Trim() -cne $version) { throw "Verified archive launched unexpected PowerShell version '$archiveRuntimeVersion'." }
          [IO.File]::AppendAllText($env:GITHUB_PATH, $installDirectory + [Environment]::NewLine, [Text.UTF8Encoding]::new($false))
          $githubEnvironment = 'SYP_REQUIRED_PWSH_VERSION=' + $version + [Environment]::NewLine + 'SYP_REQUIRED_PWSH_SHA256=' + $expectedSha256 + [Environment]::NewLine
          [IO.File]::AppendAllText($env:GITHUB_ENV, $githubEnvironment, [Text.UTF8Encoding]::new($false))
          Write-Host "Resolved PowerShell $version from a SHA-256 verified ZIP; portable path: $powerShellExe"

      - name: Verify the selected PowerShell runtime
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $expectedExecutable = [IO.Path]::GetFullPath((Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6/pwsh.exe'))
          $selectedExecutable = [IO.Path]::GetFullPath((Get-Command pwsh -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source)
          $processExecutable = [IO.Path]::GetFullPath([Diagnostics.Process]::GetCurrentProcess().MainModule.FileName)
          $homeExecutable = [IO.Path]::GetFullPath((Join-Path $PSHOME 'pwsh.exe'))
          if (-not [string]::Equals($processExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase) -or
              -not [string]::Equals($homeExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) {
            throw "The actual GitHub step shell is not the verified portable PowerShell: process=$processExecutable PSHOME=$PSHOME"
          }
          if (-not [string]::Equals($selectedExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) { throw "The job shell did not select the verified portable runtime: $selectedExecutable" }
          if ($PSVersionTable.PSVersion.ToString() -cne $env:SYP_REQUIRED_PWSH_VERSION) { throw "Expected PowerShell $env:SYP_REQUIRED_PWSH_VERSION, running $($PSVersionTable.PSVersion)." }
          if ($env:SYP_REQUIRED_PWSH_SHA256 -cne '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860') { throw 'The verified PowerShell download hash binding changed.' }
          Write-Host "PowerShell runtime verified: $($PSVersionTable.PSVersion) at $selectedExecutable"

      - name: Ensure Pester 4.10.1
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $pesterModules = @(Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' })
          if ($pesterModules.Count -eq 0) {
            Install-Module Pester -RequiredVersion 4.10.1 -Scope CurrentUser -Force -SkipPublisherCheck
            $pesterModules = @(Get-Module -ListAvailable -Name Pester | Where-Object { $_.Version -eq [version]'4.10.1' })
          }
          if ($pesterModules.Count -ne 1) { throw "Expected exactly one Pester 4.10.1 module; found $($pesterModules.Count)." }
          $manifestPath = Join-Path ([string]$pesterModules[0].ModuleBase) 'Pester.psd1'
          $manifestItem = Get-Item -Force -LiteralPath $manifestPath
          if ($manifestItem.PSIsContainer -or ($manifestItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'Pester manifest must be a regular non-reparse file.' }
          $manifest = Import-PowerShellDataFile -LiteralPath $manifestPath -ErrorAction Stop
          if ([version]$manifest.ModuleVersion -ne [version]'4.10.1') { throw 'Installed Pester manifest is not version 4.10.1.' }

      - name: Download Windows Core plan
        if: needs.plan.result == 'success'
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: windows-core-plan-${{ github.run_id }}
          path: ${{ runner.temp }}/windows-core-artifacts/plan

      - name: Download Windows Core shard evidence
        if: needs.pester.result == 'success'
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          pattern: windows-core-shard-*-${{ github.run_id }}
          path: ${{ runner.temp }}/windows-core-artifacts/shards

      - name: Assert the Windows Core aggregate
        shell: pwsh
        env:
          EXPECTED_PLAN_SHA256: ${{ needs.plan.outputs.planSha256 }}
          EXPECTED_MATRIX_JSON: ${{ needs.plan.outputs.matrix }}
          NEEDS_PLAN_RESULT: ${{ needs.plan.result }}
          NEEDS_AUTHORITY_RESULT: ${{ needs.authority.result }}
          NEEDS_PESTER_RESULT: ${{ needs.pester.result }}
          NEEDS_FIXTURES_RESULT: ${{ needs.fixtures.result }}
        run: |
          $ErrorActionPreference = 'Stop'
          & ./scripts/Assert-WindowsCoreAggregate.ps1 -RepositoryRoot . -ArtifactRoot (Join-Path $env:RUNNER_TEMP 'windows-core-artifacts') -OutputPath (Join-Path $env:RUNNER_TEMP 'windows-core-aggregate-result.json')
          if (-not $?) { throw 'Windows Core aggregate validation failed.' }

      - name: Upload Windows Core aggregate evidence
        if: always() && !cancelled()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
        with:
          name: windows-core-aggregate-${{ github.run_id }}
          path: ${{ runner.temp }}/windows-core-aggregate-result.json
          if-no-files-found: error
          retention-days: 1
          overwrite: true

      - name: Fail a cancelled Windows Core aggregate
        if: cancelled()
        shell: pwsh
        run: |
          throw 'Windows Core aggregate was cancelled and must not be treated as successful.'
