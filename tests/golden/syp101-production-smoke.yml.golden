name: Windows Install Smoke

on:
  push:
    branches:
      - syp-101
      - main
  pull_request:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

jobs:
  windows-install-smoke:
    name: Windows Install Smoke
    runs-on: windows-latest
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Install verified latest stable PowerShell
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $version = '7.6.6'
          $expectedSha256 = '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860'
          $archivePath = Join-Path $env:RUNNER_TEMP 'PowerShell-7.6.6-win-x64.zip'
          $installDirectory = Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6'
          $downloadUri = 'https://github.com/PowerShell/PowerShell/releases/download/v7.6.6/PowerShell-7.6.6-win-x64.zip'
          if ((Test-Path -LiteralPath $archivePath) -or (Test-Path -LiteralPath $installDirectory)) { throw 'PowerShell setup paths must be new within this job.' }
          Invoke-WebRequest -Uri $downloadUri -OutFile $archivePath
          $actualSha256 = (Get-FileHash -LiteralPath $archivePath -Algorithm SHA256).Hash.ToUpperInvariant()
          if ($actualSha256 -cne $expectedSha256) { throw "PowerShell archive SHA256 mismatch: expected $expectedSha256, got $actualSha256." }
          Expand-Archive -LiteralPath $archivePath -DestinationPath $installDirectory
          $powerShellExe = Join-Path $installDirectory 'pwsh.exe'
          if (-not (Test-Path -LiteralPath $powerShellExe -PathType Leaf)) { throw 'Verified PowerShell archive did not contain pwsh.exe.' }
          $archiveRuntimeVersion = (& $powerShellExe -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()')
          if ($LASTEXITCODE -ne 0 -or ([string]$archiveRuntimeVersion).Trim() -cne $version) { throw "Verified archive launched unexpected PowerShell version '$archiveRuntimeVersion'." }
          [IO.File]::AppendAllText($env:GITHUB_PATH, $installDirectory + [Environment]::NewLine, [Text.UTF8Encoding]::new($false))
          $githubEnvironment = 'SYP_REQUIRED_PWSH_VERSION=' + $version + [Environment]::NewLine + 'SYP_REQUIRED_PWSH_SHA256=' + $expectedSha256 + [Environment]::NewLine
          [IO.File]::AppendAllText($env:GITHUB_ENV, $githubEnvironment, [Text.UTF8Encoding]::new($false))
          Write-Host "Downloaded PowerShell $version; ZIP SHA256: $actualSha256; portable path: $powerShellExe"

      - name: Verify the selected PowerShell runtime
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $expectedExecutable = [IO.Path]::GetFullPath((Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6/pwsh.exe'))
          $selectedExecutable = [IO.Path]::GetFullPath((Get-Command pwsh -CommandType Application -ErrorAction Stop | Select-Object -First 1).Source)
          $processExecutable = [IO.Path]::GetFullPath([Diagnostics.Process]::GetCurrentProcess().MainModule.FileName)
          $homeExecutable = [IO.Path]::GetFullPath((Join-Path $PSHOME 'pwsh.exe'))
          if (-not [string]::Equals($processExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase) -or
              -not [string]::Equals($homeExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) {
            throw "The actual GitHub step shell is not the verified portable PowerShell: process=$processExecutable PSHOME=$PSHOME"
          }
          if (-not [string]::Equals($selectedExecutable, $expectedExecutable, [StringComparison]::OrdinalIgnoreCase)) { throw "The job shell did not select the verified portable runtime: $selectedExecutable" }
          if ($PSVersionTable.PSVersion.ToString() -cne $env:SYP_REQUIRED_PWSH_VERSION) { throw "Expected PowerShell $env:SYP_REQUIRED_PWSH_VERSION, running $($PSVersionTable.PSVersion)." }
          if ($env:SYP_REQUIRED_PWSH_SHA256 -cne '02FE458BE20493FBDF43F61EA20610B811EE6C738AB1676C61B9CFCD1A33C860') { throw 'The verified PowerShell download hash binding changed.' }
          Write-Host "PowerShell runtime verified: $($PSVersionTable.PSVersion) at $selectedExecutable"

      - name: Check production lock
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          & ./scripts/update-skills-catalog-lock.ps1 -Check
          if (-not $?) { throw 'The checked-in production catalog lock is stale or invalid.' }

      - name: Run real pinned-archive production install and idempotence smoke
        shell: pwsh
        env:
          PULL_REQUEST_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: |
          $ErrorActionPreference = 'Stop'
          $PSNativeCommandUseErrorActionPreference = $false
          $artifactRoot = Join-Path $env:RUNNER_TEMP 'syp101-production-smoke-evidence'
          New-Item -ItemType Directory -Force -Path $artifactRoot | Out-Null
          $evidencePath = Join-Path $artifactRoot 'smoke-evidence.json'
          $stdoutPath = Join-Path $artifactRoot 'smoke.stdout.log'
          $stderrPath = Join-Path $artifactRoot 'smoke.stderr.log'
          $processResultPath = Join-Path $artifactRoot 'process-result.json'
          $pwshPath = [IO.Path]::GetFullPath((Join-Path $env:RUNNER_TEMP 'pwsh-7.6.6/pwsh.exe'))
          if (-not (Test-Path -LiteralPath $pwshPath -PathType Leaf)) { throw 'Verified portable PowerShell is unavailable for the production smoke child.' }
          $pwshVersion = (& $pwshPath -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()')
          if ($LASTEXITCODE -ne 0 -or ([string]$pwshVersion).Trim() -cne $env:SYP_REQUIRED_PWSH_VERSION) { throw 'Production smoke child PowerShell identity does not match the verified runtime.' }
          $checkoutHead = (& git rev-parse --verify 'HEAD^{commit}').Trim()
          if ($LASTEXITCODE -ne 0 -or $checkoutHead -notmatch '^[0-9a-f]{40}$') { throw 'Could not resolve checked-out smoke commit.' }
          $checkoutTree = (& git rev-parse --verify 'HEAD^{tree}').Trim()
          if ($LASTEXITCODE -ne 0 -or $checkoutTree -notmatch '^[0-9a-f]{40}$') { throw 'Could not resolve checked-out smoke tree.' }
          $sourceHead = if ($env:PULL_REQUEST_HEAD_SHA -match '^[0-9a-f]{40}$') { $env:PULL_REQUEST_HEAD_SHA } else { $env:GITHUB_SHA }
          $repositoryRoot = [IO.Path]::GetFullPath((Get-Location).Path)
          $smokeScript = [IO.Path]::GetFullPath('./scripts/test-syp101-production-smoke.ps1')
          $scriptHash = (Get-FileHash -LiteralPath $smokeScript -Algorithm SHA256).Hash.ToLowerInvariant()
          $env:SYP101_SOURCE_HEAD_SHA = $sourceHead
          $command = @($pwshPath, '-NoLogo', '-NoProfile', '-File', $smokeScript, '-RepositoryRoot', $repositoryRoot, '-EvidencePath', $evidencePath)
          $startedAt = [DateTime]::UtcNow.ToString('o')
          $childExitCode = $null
          $completionState = 'launch-failed'
          $launchError = $null
          try {
            & $pwshPath -NoLogo -NoProfile -File $smokeScript -RepositoryRoot $repositoryRoot -EvidencePath $evidencePath 1> $stdoutPath 2> $stderrPath
            $childExitCode = $LASTEXITCODE
            $completionState = 'exited'
          }
          catch {
            $launchError = $_.Exception.Message
          }
          $completedAt = [DateTime]::UtcNow.ToString('o')
          $evidenceExists = Test-Path -LiteralPath $evidencePath -PathType Leaf
          $processResult = [ordered]@{
            schemaVersion = 1; runId = [string]$env:GITHUB_RUN_ID; runAttempt = [string]$env:GITHUB_RUN_ATTEMPT
            workflow = [string]$env:GITHUB_WORKFLOW; event = [string]$env:GITHUB_EVENT_NAME; ref = [string]$env:GITHUB_REF
            sourceHeadCommit = $sourceHead; checkoutHeadCommit = $checkoutHead; checkoutTree = $checkoutTree
            command = $command; scriptSha256 = $scriptHash; pwshVersion = ([string]$pwshVersion).Trim()
            pwshExecutable = $pwshPath; verifiedPwshArchiveSha256 = [string]$env:SYP_REQUIRED_PWSH_SHA256
            startedAtUtc = $startedAt; completedAtUtc = $completedAt; completionState = $completionState
            childExitCode = $childExitCode; childExitStatus = $(if ($null -eq $childExitCode) { 'unknown' } elseif ($childExitCode -eq 0) { 'passed' } else { 'failed' })
            launchError = $launchError; evidenceExists = $evidenceExists
            evidenceSha256 = $(if ($evidenceExists) { (Get-FileHash -LiteralPath $evidencePath -Algorithm SHA256).Hash.ToLowerInvariant() } else { $null })
            stdoutPath = $stdoutPath; stdoutLength = $(if (Test-Path -LiteralPath $stdoutPath -PathType Leaf) { [long](Get-Item -LiteralPath $stdoutPath).Length } else { $null })
            stdoutSha256 = $(if (Test-Path -LiteralPath $stdoutPath -PathType Leaf) { (Get-FileHash -LiteralPath $stdoutPath -Algorithm SHA256).Hash.ToLowerInvariant() } else { $null })
            stderrPath = $stderrPath; stderrLength = $(if (Test-Path -LiteralPath $stderrPath -PathType Leaf) { [long](Get-Item -LiteralPath $stderrPath).Length } else { $null })
            stderrSha256 = $(if (Test-Path -LiteralPath $stderrPath -PathType Leaf) { (Get-FileHash -LiteralPath $stderrPath -Algorithm SHA256).Hash.ToLowerInvariant() } else { $null })
            evidencePath = $evidencePath
          }
          [IO.File]::WriteAllText($processResultPath, ($processResult | ConvertTo-Json -Depth 8) + "`n", [Text.UTF8Encoding]::new($false))
          if ($completionState -cne 'exited' -or $null -eq $childExitCode -or $childExitCode -ne 0 -or -not $evidenceExists) {
            throw 'The real pinned-archive production smoke failed or omitted its evidence JSON.'
          }
          Write-Host "Production smoke evidence saved: $evidencePath; process result: $processResultPath"

      - name: Upload production smoke evidence
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
        with:
          name: syp101-production-smoke-evidence-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/syp101-production-smoke-evidence/smoke-evidence.json
            ${{ runner.temp }}/syp101-production-smoke-evidence/process-result.json
            ${{ runner.temp }}/syp101-production-smoke-evidence/smoke.stdout.log
            ${{ runner.temp }}/syp101-production-smoke-evidence/smoke.stderr.log
          if-no-files-found: warn
          retention-days: 1
