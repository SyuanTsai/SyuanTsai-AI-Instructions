{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/runtime-bundle-v3.schema.json",
  "title": "Installed AI Instructions runtime bundle v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "commit", "acquisition", "archiveSha256", "inventorySha256", "inventory", "platform", "platformRuntime", "requiredCapabilities", "projectionContractSha256"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "repository": { "type": "string", "const": "https://github.com/SyuanTsai/SyuanTsai-AI-Instructions.git" },
    "commit": { "$ref": "#/$defs/commit" },
    "acquisition": { "enum": ["git-checkout", "github-codeload"] },
    "archiveSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
    "inventorySha256": {
      "$ref": "#/$defs/hash",
      "description": "SHA-256 of <path>\\t<sha256>\\n lines encoded as UTF-8 without BOM after sorting paths with ordinal comparison."
    },
    "inventory": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001F\\u007F\\\\]+$" },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": { "enum": ["windows", "linux", "macos"] },
        "architecture": { "enum": ["x64", "arm64"] }
      }
    },
    "platformRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "manifestSha256", "sourceFingerprint"],
      "properties": {
        "apiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "manifestSha256": { "$ref": "#/$defs/hash" },
        "sourceFingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "requiredCapabilities": {
      "description": "Bundle-declared requirements. Structural contract validation enforces known unique names and the eight projection-runtime minimum capabilities; the operational installer, launcher, and updater gates validate the exact runtime inventory and manifest closure before importing platform-runtime, then call Get-PlatformCapabilities -Required <requiredCapabilities> on the target host and fail closed if any capability is unavailable.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["directory-lease", "file-lease", "file-identity", "lock", "publication", "owned-file-removal", "directory-publication", "permissions", "process-isolation", "owned-process", "process-cleanup", "powershell-resolution", "pester-initialization", "powershell-runtime", "pester-module", "process-environment"] }
    },
    "projectionContractSha256": { "$ref": "#/$defs/hash" }
  },
  "allOf": [{
    "if": { "properties": { "acquisition": { "const": "github-codeload" } } },
    "then": { "properties": { "archiveSha256": { "$ref": "#/$defs/hash" } } }
  }],
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
