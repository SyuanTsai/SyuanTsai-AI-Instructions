{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/skills-catalog-v3.schema.json",
  "title": "Agent Skills Catalog v3 (canonical source and bounded projections)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "sources", "profiles", "skills", "projections"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "catalogId": { "$ref": "#/$defs/stableId" },
    "sources": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "repository"], "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "repository": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/[^/]+/[^/]+(?:\\.git)?/?$" }
      } }
    },
    "profiles": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "description", "default", "includes", "excludes"], "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "description": { "type": "string", "minLength": 1 }, "default": { "type": "boolean" },
        "includes": { "$ref": "#/$defs/stableIdArray" }, "excludes": { "$ref": "#/$defs/stableIdArray" }
      } }
    },
    "skills": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/skill" } },
    "projections": {
      "type": "array", "minItems": 1, "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "user-agents" } } },
      "items": { "$ref": "#/$defs/projection" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "user-agents" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "user-claude" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "user-copilot" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "project-agents" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "project-claude" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "project-github" } } }, "minContains": 0, "maxContains": 1 }
      ]
    }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "stableIdArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
    "projection": {
      "type": "object", "additionalProperties": false, "required": ["id", "scope", "root"],
      "oneOf": [
        { "properties": { "id": { "const": "user-agents" }, "scope": { "const": "user" }, "root": { "const": ".agents/skills" } } },
        { "properties": { "id": { "const": "user-claude" }, "scope": { "const": "user" }, "root": { "const": ".claude/skills" } } },
        { "properties": { "id": { "const": "user-copilot" }, "scope": { "const": "user" }, "root": { "const": ".copilot/skills" } } },
        { "properties": { "id": { "const": "project-agents" }, "scope": { "const": "project" }, "root": { "const": ".agents/skills" } } },
        { "properties": { "id": { "const": "project-claude" }, "scope": { "const": "project" }, "root": { "const": ".claude/skills" } } },
        { "properties": { "id": { "const": "project-github" }, "scope": { "const": "project" }, "root": { "const": ".github/skills" } } }
      ]
    },
    "capability": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "state"], "properties": {
      "kind": { "type": "string", "enum": ["command", "connector", "environment"] }, "id": { "$ref": "#/$defs/stableId" },
      "state": { "type": "string", "enum": ["available", "authenticated", "configured"] }
    } },
    "dependency": {
      "type": "object", "additionalProperties": false, "required": ["skillId", "type"],
      "properties": {
        "skillId": { "$ref": "#/$defs/stableId" }, "type": { "type": "string", "enum": ["hard", "conditional", "recommended"] },
        "condition": { "type": "object", "additionalProperties": false, "required": ["capability", "operator"], "properties": { "capability": { "$ref": "#/$defs/stableId" }, "operator": { "type": "string", "enum": ["available", "missing", "missing-or-invalid", "unavailable"] } } },
        "fallback": { "type": "object", "additionalProperties": false, "required": ["capability", "description"], "properties": { "capability": { "$ref": "#/$defs/stableId" }, "description": { "type": "string", "minLength": 1 } } }
      },
      "allOf": [{ "if": { "properties": { "type": { "const": "conditional" } }, "required": ["type"] }, "then": { "required": ["condition", "fallback"] }, "else": { "not": { "anyOf": [{ "required": ["condition"] }, { "required": ["fallback"] }] } } }]
    },
    "source": { "type": "object", "additionalProperties": false, "required": ["sourceId", "sourcePath"], "properties": {
      "sourceId": { "$ref": "#/$defs/stableId" }, "sourcePath": { "type": "string", "pattern": "^skills/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" }
    } },
    "skill": {
      "type": "object", "additionalProperties": false, "required": ["id", "group", "source", "profiles", "compatibility", "dependencies", "lifecycle"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "group": { "$ref": "#/$defs/stableId" }, "source": { "$ref": "#/$defs/source" }, "profiles": { "$ref": "#/$defs/stableIdArray" },
        "compatibility": { "type": "object", "additionalProperties": false, "required": ["platforms", "shells", "requiredCapabilities", "anyOfCapabilities"], "properties": {
          "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["any", "linux", "macos", "windows"] } },
          "shells": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "requiredCapabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
          "anyOfCapabilities": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } } }
        } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "lifecycle": { "type": "object", "additionalProperties": false, "required": ["status", "aliases"], "properties": { "status": { "type": "string", "enum": ["active", "deprecated", "removed"] }, "aliases": { "$ref": "#/$defs/stableIdArray" }, "replacementId": { "$ref": "#/$defs/stableId" } } }
      }
    }
  }
}
