{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ai-instructions-sync-v5.schema.json",
  "title": "Personal AI Instructions sync configuration v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "excludedRepositoryUrls", "excludedRepositoryPaths", "catalog", "updates", "projections"],
  "properties": {
    "schemaVersion": { "const": 5 },
    "excludedRepositoryUrls": { "$ref": "#/$defs/stringArray" },
    "excludedRepositoryPaths": { "$ref": "#/$defs/stringArray" },
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "ref", "profiles", "includeSkills", "excludeSkills"],
      "properties": {
        "repository": { "type": "string", "const": "https://github.com/SyuanTsai/SyuanTsai-AI-Instructions.git" },
        "ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "profiles": { "$ref": "#/$defs/stableIdArray" },
        "includeSkills": { "$ref": "#/$defs/stableIdArray" },
        "excludeSkills": { "$ref": "#/$defs/stableIdArray" }
      }
    },
    "updates": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "channel", "ref", "minimumCheckIntervalMinutes"],
      "properties": {
        "mode": { "enum": ["notify-only", "auto-install-approved"] },
        "channel": { "enum": ["protected-branch", "github-release"] },
        "ref": { "enum": ["main", "latest"] },
        "minimumCheckIntervalMinutes": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      },
      "allOf": [
        { "if": { "properties": { "channel": { "const": "protected-branch" } } }, "then": { "properties": { "ref": { "const": "main" } } } },
        { "if": { "properties": { "channel": { "const": "github-release" } } }, "then": { "properties": { "ref": { "const": "latest" } } } }
      ]
    },
    "projections": {
      "type": "object", "additionalProperties": false,
      "required": ["user", "project"],
      "properties": {
        "user": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "contains": { "const": "user-agents" }, "minContains": 1,
          "items": { "enum": ["user-agents", "user-claude", "user-copilot"] }
        },
        "project": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["project-agents", "project-claude", "project-github"] }
        }
      }
    }
  },
  "$defs": {
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "stableIdArray": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" } }
  }
}
