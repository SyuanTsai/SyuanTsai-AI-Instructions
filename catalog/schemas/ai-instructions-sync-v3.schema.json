{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ai-instructions-sync-v3.schema.json",
  "title": "Personal AI Instructions sync configuration v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "autoCommitRepositoryUrls",
    "excludedRepositoryUrls",
    "excludedRepositoryPaths",
    "catalog"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "autoCommitRepositoryUrls": {
      "$ref": "#/$defs/stringArray"
    },
    "excludedRepositoryUrls": {
      "$ref": "#/$defs/stringArray"
    },
    "excludedRepositoryPaths": {
      "$ref": "#/$defs/stringArray"
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "profiles",
        "includeSkills",
        "excludeSkills"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[^/]+/[^/]+\\.git$"
        },
        "ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "profiles": {
          "$ref": "#/$defs/stableIdArray"
        },
        "includeSkills": {
          "$ref": "#/$defs/stableIdArray"
        },
        "excludeSkills": {
          "$ref": "#/$defs/stableIdArray"
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stableIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
      }
    }
  }
}
