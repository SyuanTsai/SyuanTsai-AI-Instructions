{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ai-instructions-install-journal-v1.schema.json",
  "title": "AI Instructions install transaction journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "transactionId",
    "createdAtUtc",
    "owner",
    "platform",
    "lock",
    "generation",
    "phase",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ai-instructions-install-transaction" },
    "transactionId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "processId", "processStartIdentity"],
      "properties": {
        "component": { "enum": ["installer", "updater", "launcher-recovery"] },
        "processId": { "type": "integer", "minimum": 1 },
        "processStartIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": { "enum": ["windows", "linux", "macos"] },
        "architecture": { "enum": ["x64", "arm64"] }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "leaf"],
      "properties": {
        "primitive": { "enum": ["windows-fileshare", "flock"] },
        "leaf": { "$ref": "#/$defs/portableLeaf" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousBundleSha256", "candidateBundleSha256"],
      "properties": {
        "previousBundleSha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/hash" }
          ]
        },
        "candidateBundleSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "phase": {
      "enum": ["prepared", "applying", "applied", "rolling-back", "rolled-back", "committed"]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "prepared" } } },
      "then": {
        "properties": {
          "operations": { "items": { "properties": { "state": { "enum": ["pending", "staged"] } } } }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "enum": ["applied", "committed"] } } },
      "then": {
        "properties": {
          "operations": { "items": { "properties": { "state": { "const": "applied" } } } }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "rolled-back" } } },
      "then": {
        "properties": {
          "operations": { "items": { "properties": { "state": { "enum": ["pending", "staged", "rolled-back"] } } } }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "properties": { "os": { "const": "windows" } } } } },
      "then": {
        "properties": {
          "lock": { "properties": { "primitive": { "const": "windows-fileshare" } } },
          "operations": {
            "items": {
              "properties": {
                "original": { "properties": { "identity": { "$ref": "#/$defs/windowsIdentityOrNull" } } },
                "backupIdentity": { "$ref": "#/$defs/windowsIdentityOrNull" },
                "applied": { "properties": { "identity": { "$ref": "#/$defs/windowsIdentityOrNull" } } },
                "permissions": { "properties": { "kind": { "const": "windows-sddl" } } }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "lock": { "properties": { "primitive": { "const": "flock" } } },
          "operations": {
            "items": {
              "properties": {
                "original": { "properties": { "identity": { "$ref": "#/$defs/unixIdentityOrNull" } } },
                "backupIdentity": { "$ref": "#/$defs/unixIdentityOrNull" },
                "applied": { "properties": { "identity": { "$ref": "#/$defs/unixIdentityOrNull" } } },
                "permissions": { "properties": { "kind": { "const": "unix-mode" } } }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "leaf": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[^/\\\\\\u0000-\\u001F\\u007F]+$",
      "not": { "enum": [".", ".."] }
    },
    "portableLeaf": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])(?!.*[.\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]$)[^/\\\\:*?\"<>|\\u0000-\\u001F\\u007F]+$",
      "not": { "enum": [".", ".."] }
    },
    "fileState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "sha256", "length", "identity"],
      "properties": {
        "exists": { "type": "boolean" },
        "sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/hash" }
          ]
        },
        "length": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "identity": { "$ref": "#/$defs/identity" }
      },
      "allOf": [
        {
          "if": { "properties": { "exists": { "const": false } } },
          "then": {
            "properties": {
              "sha256": { "type": "null" },
              "length": { "type": "null" },
              "identity": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "sha256": { "$ref": "#/$defs/hash" },
              "length": { "type": "integer", "minimum": 0 }
            }
          }
        }
      ]
    },
    "identityObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "device", "fileId"],
      "properties": {
        "kind": { "enum": ["windows-file-id", "unix-device-inode"] },
        "device": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Fa-fx:-]+$" },
        "fileId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Fa-fx:-]+$" }
      }
    },
    "identity": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/identityObject" }
      ]
    },
    "windowsIdentityOrNull": {
      "oneOf": [
        { "type": "null" },
        { "allOf": [{ "$ref": "#/$defs/identityObject" }, { "properties": { "kind": { "const": "windows-file-id" } } }] }
      ]
    },
    "unixIdentityOrNull": {
      "oneOf": [
        { "type": "null" },
        { "allOf": [{ "$ref": "#/$defs/identityObject" }, { "properties": { "kind": { "const": "unix-device-inode" } } }] }
      ]
    },
    "permissions": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sddl", "readOnly"],
          "properties": {
            "kind": { "const": "windows-sddl" },
            "sddl": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^(?!.*[OoGgSs]:)[Dd]:[^\\u0000-\\u001F\\u007F]*$" },
            "readOnly": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mode", "uid", "gid"],
          "properties": {
            "kind": { "const": "unix-mode" },
            "mode": { "type": "string", "pattern": "^[0-7]{3,4}$" },
            "uid": { "type": "integer", "minimum": 0 },
            "gid": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "kind",
        "method",
        "targetRelativePath",
        "stageLeaf",
        "backupLeaf",
        "original",
        "backupIdentity",
        "applied",
        "permissions",
        "state"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["write-file", "create-file", "remove-file", "swap-directory"] },
        "method": { "enum": ["stage-rename", "tombstone-rename"] },
        "targetRelativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?![.][aA][iI]-[iI][nN][sS][tT][rR][uU][cC][tT][iI][oO][nN][sS]-[tT][xX][nN](?:/|$))(?![\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+(?:/|$))(?!.*\\/[\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+(?:/|$))(?!/)(?!.*\\/$)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[:*?\"<>|])(?!.*[.\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:/|$))[^\\u0000-\\u001F\\u007F]+$"
        },
        "stageLeaf": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/portableLeaf" }
          ]
        },
        "backupLeaf": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/portableLeaf" }
          ]
        },
        "original": { "$ref": "#/$defs/fileState" },
        "backupIdentity": { "$ref": "#/$defs/identity" },
        "applied": { "$ref": "#/$defs/fileState" },
        "permissions": { "$ref": "#/$defs/permissions" },
        "state": { "enum": ["pending", "staged", "applied", "rolled-back"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "create-file" } } },
          "then": {
            "properties": {
              "backupLeaf": { "type": "null" },
              "original": { "properties": { "exists": { "const": false } } },
              "applied": { "properties": { "exists": { "const": true } } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "remove-file" } } },
          "then": {
            "properties": {
              "method": { "const": "tombstone-rename" },
              "stageLeaf": { "type": "null" },
              "state": { "enum": ["pending", "applied", "rolled-back"] },
              "original": { "properties": { "exists": { "const": true } } },
              "backupIdentity": { "$ref": "#/$defs/identityObject" },
              "applied": { "properties": { "exists": { "const": false } } }
            }
          },
          "else": {
            "properties": {
              "method": { "const": "stage-rename" },
              "stageLeaf": { "$ref": "#/$defs/portableLeaf" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "enum": ["write-file", "swap-directory"] } } },
          "then": {
            "properties": {
              "original": { "properties": { "exists": { "const": true } } },
              "applied": { "properties": { "exists": { "const": true } } }
            }
          }
        },
        {
          "if": { "properties": { "original": { "properties": { "exists": { "const": true } } } } },
          "then": {
            "properties": {
              "backupLeaf": { "$ref": "#/$defs/portableLeaf" },
              "original": { "properties": { "identity": { "$ref": "#/$defs/identityObject" } } },
              "permissions": { "not": { "type": "null" } }
            }
          },
          "else": {
            "properties": {
              "backupIdentity": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "original": { "properties": { "exists": { "const": true } } },
              "state": { "enum": ["staged", "applied", "rolled-back"] }
            }
          },
          "then": {
            "properties": {
              "backupIdentity": { "$ref": "#/$defs/identityObject" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": { "enum": ["staged", "applied", "rolled-back"] },
              "applied": { "properties": { "exists": { "const": true } } }
            }
          },
          "then": { "properties": { "applied": { "properties": { "identity": { "$ref": "#/$defs/identityObject" } } } } }
        }
      ]
    }
  }
}
